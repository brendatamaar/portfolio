---
import BaseHead from '../components/BaseHead.astro'
import SiteHeader from '../components/SiteHeader.astro'
import SiteFooter from '../components/SiteFooter.astro'
import Icon from '../components/Icon.astro'
import '../globals.css'
import '../blog.css'

interface Props {
  title: string
  description?: string
  canonicalUrl?: string
  lang?: 'en' | 'id'
}

const {
  title,
  description = 'Read on brendatama.dev',
  canonicalUrl,
  lang = 'en',
} = Astro.props
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead {title} {description} ogType="article" {canonicalUrl} preconnectApi />
  </head>
  <body>
    <!-- Scroll progress bar -->
    <div
      id="scroll-progress"
      class="fixed top-0 left-0 z-50 h-[3px] w-full origin-left scale-x-0 bg-teal"
      aria-hidden="true"
    ></div>

    <!-- Back to top -->
    <button
      id="back-to-top"
      type="button"
      tabindex="-1"
      class="pointer-events-none fixed right-5 bottom-6 z-40 flex h-11 w-11 items-center justify-center rounded-full bg-teal text-white opacity-0 shadow-raised transition-all hover:bg-teal-hover sm:right-8 sm:bottom-8"
      aria-label="Back to top"
    >
      <Icon name="arrow-up" class="h-5 w-5" strokeWidth={1.8} />
    </button>

    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[9999] focus:rounded-xs focus:bg-teal focus:px-4 focus:py-2 focus:type-button focus:text-white"
    >
      Skip to main content
    </a>

    <!-- Nav — max-w-3xl -->
    <div class="mx-auto max-w-3xl px-4 pt-10 sm:px-6 sm:pt-16">
      <SiteHeader current="writing" />
    </div>

    <!-- Post header — max-w-3xl -->
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <slot name="header" />
    </div>

    <!-- 3-col content — max-w-[72rem] -->
    <main id="main" class="mx-auto max-w-[72rem] px-4 pb-16 sm:px-6">
      <slot />
    </main>

    <!-- Below content — max-w-3xl -->
    <div class="mx-auto max-w-3xl px-4 pb-16 sm:px-6">
      <slot name="footer" />
    </div>

    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <SiteFooter />
    </div>
  </body>
</html>
