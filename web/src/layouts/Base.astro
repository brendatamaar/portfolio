---
import BaseHead from '../components/BaseHead.astro'
import SiteHeader from '../components/SiteHeader.astro'
import SiteFooter from '../components/SiteFooter.astro'
import '../globals.css'

interface Props {
  title?: string
  description?: string
  ogType?: string
  canonicalUrl?: string
  lang?: 'en' | 'id'
  current?: 'home' | 'writing'
  /** Gradient banner behind the top of the page: warm (homepage) or cool */
  banner?: 'warm' | 'cool'
}

const {
  title = 'Brendatama Akbar — Web Software Developer',
  description = 'Web Software Developer based in Jakarta, Indonesia.',
  ogType = 'website',
  canonicalUrl,
  lang = 'en',
  current = 'home',
  banner = 'warm',
} = Astro.props
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead {title} {description} {ogType} {canonicalUrl} />
    <slot name="head" />
  </head>
  <body class="relative flex min-h-screen flex-col">
    <div
      class:list={[
        'pointer-events-none absolute inset-x-0 top-0 h-[560px]',
        banner === 'warm' ? 'bg-hero' : 'bg-hero-alt',
      ]}
      aria-hidden="true"
    ></div>

    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[9999] focus:rounded-xs focus:bg-teal focus:px-4 focus:py-2 focus:type-button focus:text-white"
    >
      Skip to main content
    </a>

    <SiteHeader {current} />

    <main id="main" class="relative mx-auto w-full max-w-3xl flex-1 px-4 pt-14 pb-24 sm:px-6 sm:pt-20">
      <slot />
    </main>

    <SiteFooter />
  </body>
</html>
