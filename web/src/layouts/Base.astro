---
import BaseHead from '../components/BaseHead.astro'
import SiteHeader from '../components/SiteHeader.astro'
import SiteFooter from '../components/SiteFooter.astro'
import '../globals.css'

interface Props {
  title?: string
  description?: string
  ogType?: string
  canonicalUrl?: string
  lang?: 'en' | 'id'
  current?: 'home' | 'writing'
}

const {
  title = 'Brendatama Akbar — Web Software Developer',
  description = 'Web Software Developer based in Jakarta, Indonesia.',
  ogType = 'website',
  canonicalUrl,
  lang = 'en',
  current = 'home',
} = Astro.props
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead {title} {description} {ogType} {canonicalUrl} />
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[9999] focus:rounded-xs focus:bg-teal focus:px-4 focus:py-2 focus:type-button focus:text-white"
    >
      Skip to main content
    </a>

    <SiteHeader {current} />

    <main id="main" class="flex-1">
      <slot />
    </main>

    <SiteFooter />
  </body>
</html>
