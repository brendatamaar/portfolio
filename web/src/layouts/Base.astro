---
import BaseHead from '../components/BaseHead.astro'
import ThemeToggle from '../components/ThemeToggle.astro'
import '../globals.css'

interface Props {
  title?: string
  description?: string
  ogType?: string
  canonicalUrl?: string
  lang?: 'en' | 'id'
}

const {
  title = 'Brendatama Akbar — Web Software Developer',
  description = 'Web Software Developer based in Jakarta, Indonesia.',
  ogType = 'website',
  canonicalUrl,
  lang = 'en',
} = Astro.props
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead {title} {description} {ogType} {canonicalUrl} />
    <slot name="head" />
  </head>
  <body class="bg-white text-black dark:bg-black dark:text-white">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[9999] focus:border-2 focus:border-black focus:bg-[#FFE600] focus:px-4 focus:py-2 focus:font-mono focus:text-xs focus:font-bold focus:tracking-widest focus:text-black focus:uppercase"
    >
      Skip to main content
    </a>

    <div class="mx-auto max-w-3xl px-6 py-10 sm:py-16">
      <header
        class="mb-16 flex items-center justify-between border-b-2 border-black pb-5 dark:border-white"
      >
        <a
          href="/"
          class="font-mono text-xs font-bold tracking-widest text-black uppercase dark:text-white"
        >
          home
        </a>
        <nav class="flex items-center gap-5">
          <a
            href="/blog"
            class="font-mono text-xs tracking-widest text-black uppercase hover:underline dark:text-white"
          >
            writing
          </a>
          <ThemeToggle />
        </nav>
      </header>

      <main id="main">
        <slot />
      </main>

      <footer class="mt-24 border-t-2 border-black pt-6 pb-10 dark:border-white">
        <div class="flex items-center justify-between">
          <span
            class="font-mono text-[11px] tracking-widest text-black/60 uppercase dark:text-white/60"
          >
            © {new Date().getFullYear()} Brendatama Akbar Ramadan
          </span>
          <span
            class="font-mono text-[11px] tracking-widest text-black/60 uppercase dark:text-white/60"
          >
            Jakarta, Indonesia
          </span>
        </div>
      </footer>
    </div>
  </body>
</html>
