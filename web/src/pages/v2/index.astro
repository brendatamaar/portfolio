---
import V2 from '../../v2/layouts/V2.astro'
import Hive from '../../v2/components/Hive.astro'
import ProjectCard from '../../v2/components/ProjectCard.astro'
import SectionHead from '../../v2/components/SectionHead.astro'
import Connect from '../../v2/components/Connect.astro'
import Roll from '../../v2/components/Roll.astro'
import Icon from '../../components/Icon.astro'
import { copy, formatDate, lineOrder, loadPosts, loadResume, site, socials } from '../../v2/data/content'

const [resume, posts] = await Promise.all([loadResume(), loadPosts(3)])
const { grid: workProjects, off: sideProjects } = lineOrder(resume)
const profile = resume.profile
const email = profile?.email
const links = socials(resume)
const company = (name: string) => (name === 'Icon Plus' ? 'PLN Icon Plus' : name)
const projectsAt = (name: string) => workProjects.filter((p) => p.company === name)
const realLink = (href?: string) => (href && href !== '#' ? href : undefined)

// Tech stack marquee: repeat short lists so each half is wider than the column
const MARQUEE_MIN = 14
const marquee = resume.skills.length
  ? Array.from({ length: Math.ceil(MARQUEE_MIN / resume.skills.length) }, () => resume.skills).flat()
  : []
const pill =
  'inline-flex h-[34px] shrink-0 items-center rounded-3xl border border-line-soft bg-surface px-4 text-[13px] font-semibold whitespace-nowrap text-heading'
---

<V2>
  <!-- Hero: who, what, where to go; the honeycomb holds real screens of the work -->
  <section class="relative" aria-labelledby="hero-title">
    <div class="container-wide grid items-center gap-12 pt-12 pb-20 md:pt-20 lg:grid-cols-12 lg:gap-8 lg:pt-24 lg:pb-28">
      <div class="lg:col-span-7">
        <span class="banner-tag mb-7" data-reveal="fade" data-intro>
          <Icon name="pin" class="h-4 w-4 text-teal" />
          {profile?.location ?? 'Jakarta, Indonesia'}
        </span>
        <h1 id="hero-title" class="type-display text-heading" data-settle>
          <span class="ink-peach">Hi, I’m Brendatama.</span>
          <span>Web software developer based in Jakarta.</span>
        </h1>
        <p class="mt-6 max-w-xl type-lead text-body" data-split="lines" data-intro data-delay="0.25">{copy.heroLead}</p>
        <div class="mt-9 flex flex-wrap items-center gap-3" data-reveal="up" data-intro data-delay="0.4">
          <a href={site.resume} download class="btn btn-primary" data-astro-reload>
            <Icon name="download" class="h-4 w-4" strokeWidth={2} />
            <Roll text="Download resume" />
          </a>
          {
            email && (
              <a href={`mailto:${email}`} class="btn btn-outline">
                <Icon name="mail" class="h-4 w-4" strokeWidth={2} />
                <Roll text="Email me" />
              </a>
            )
          }
        </div>
        {
          links.length > 0 && (
            <div data-reveal="fade" data-intro data-delay="0.55">
              <p class="mt-9 mb-3 type-subtitle text-[11px] text-muted">Find me on</p>
              <div class="flex flex-wrap gap-2.5">
                {links.map((s) => (
                  <a href={s.href} target="_blank" rel="noopener noreferrer" class="chip h-8">
                    <Roll text={s.label} />
                    <Icon name="external" class="nudge-up nudge h-3 w-3" strokeWidth={2} />
                  </a>
                ))}
              </div>
            </div>
          )
        }
      </div>

      <div class="relative lg:col-span-5">
        <div class="dots pointer-events-none absolute -top-6 -left-4 h-28 w-40 text-teal/40" aria-hidden="true"></div>
        <Hive
          intro
          class="mx-auto w-[86%] max-w-[520px] lg:w-full"
          cells={[
            { col: 0, row: 0, kind: 'butter', depth: 0.8 },
            { col: 0, row: 1, kind: 'teal', depth: 0.35 },
            { col: 0, row: 2, kind: 'lilac', depth: 0.6 },
            { col: 1, row: 0, kind: 'shot', img: '/v2/img/cheskp-960.webp', depth: 0.45 },
            { col: 1, row: 1, kind: 'apricot', depth: 0.9 },
            { col: 2, row: 0, kind: 'butter', depth: 0.7 },
            { col: 2, row: 1, kind: 'shot', img: '/v2/img/airtax-960.webp', depth: 0.3 },
            { col: 2, row: 2, kind: 'teal', depth: 0.55 },
            { col: 3, row: 0, kind: 'outline', depth: 0.4 },
            { col: 3, row: 1, kind: 'peach', depth: 0.75 },
          ]}
        />
      </div>
    </div>
  </section>

  <!-- 01. Projects -->
  {
    sideProjects.length > 0 && (
      <section id="projects" data-section="projects" class="relative pb-24 md:pb-32" aria-labelledby="projects-title">
        <div class="container-wide">
          <SectionHead id="projects-title" num="01" title={copy.projects.title} eyebrow={copy.projects.eyebrow} lead={copy.projects.lead} />
          <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 lg:gap-7">
            {sideProjects.map((p, i) => (
              <li class:list={[i === 0 && 'md:col-span-2']}>
                <ProjectCard project={p} wide={i === 0} index={i} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- 02. Work: every job, and the products behind the current one -->
  <section id="work" data-section="work" class="relative overflow-hidden bg-sunken py-24 md:py-32" aria-labelledby="work-title">
    <div class="hex pointer-events-none absolute -top-16 -right-16 hidden aspect-[1.15] w-56 bg-apricot/50 lg:block dark:bg-teal/10" aria-hidden="true"></div>
    <div class="container-wide relative">
      <SectionHead id="work-title" num="02" title={copy.work.title} eyebrow={copy.work.eyebrow} lead={copy.work.lead} />

      <ol class="border-t border-line">
        {
          resume.work.map((w) => {
            const projects = projectsAt(w.company)
            const link = realLink(w.link)
            return (
              <li class="border-b border-line">
                <div class="grid gap-6 py-10 lg:grid-cols-[320px_1fr] lg:gap-14 lg:py-12">
                  <div class="lg:sticky lg:top-24 lg:self-start" data-reveal="up">
                    <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1">
                      <h3 class="text-xl leading-snug font-bold text-heading md:text-2xl">
                        {link ? (
                          <a href={link} target="_blank" rel="noopener noreferrer" class="group/l inline-flex items-center gap-1.5 hover:text-link">
                            {company(w.company)}
                            <Icon name="external" class="h-4 w-4 text-teal transition-transform group-hover/l:translate-x-0.5 group-hover/l:-translate-y-0.5" />
                          </a>
                        ) : (
                          company(w.company)
                        )}
                      </h3>
                      {w.end.toLowerCase() === 'now' && <span class="tag">Now</span>}
                    </div>
                    <p class="mt-1 text-muted">{w.title}</p>
                    <span class="mt-4 inline-flex h-7 items-center gap-1.5 rounded-3xl border border-line-soft bg-surface px-3 text-[12px] font-semibold text-heading tabular-nums">
                      <Icon name="calendar" class="h-3.5 w-3.5 text-teal" />
                      {w.start} to {w.end}
                    </span>
                  </div>
                  <div class="min-w-0">
                    <p class="text-base leading-relaxed text-body" data-reveal="up">
                      {w.description}
                    </p>
                    {projects.length > 0 && (
                      <ul class="mt-7 grid gap-5 sm:grid-cols-2">
                        {projects.map((p, i) => (
                          <li>
                            <ProjectCard project={p} compact index={i} />
                          </li>
                        ))}
                      </ul>
                    )}
                  </div>
                </div>
              </li>
            )
          })
        }
      </ol>

      {
        resume.skills.length > 0 && (
          <div class="mt-12 grid gap-4 lg:grid-cols-[320px_1fr] lg:items-center lg:gap-14">
            <p id="stack-label" class="type-subtitle text-[11px] text-muted">
              Tech stack
            </p>
            <ul aria-labelledby="stack-label" class="sr-only motion-reduce:not-sr-only motion-reduce:flex motion-reduce:flex-wrap motion-reduce:gap-2.5">
              {resume.skills.map((s) => (
                <li class={pill}>{s}</li>
              ))}
            </ul>
            <div class="marquee min-w-0 overflow-hidden motion-reduce:hidden" data-marquee aria-hidden="true">
              <div class="flex w-max" data-track>
                {[0, 1].map(() => (
                  <div class="flex shrink-0 gap-2.5 pr-2.5">
                    {marquee.map((s) => (
                      <span class={pill}>{s}</span>
                    ))}
                  </div>
                ))}
              </div>
            </div>
          </div>
        )
      }
    </div>
  </section>

  <!-- 03. Writing -->
  <section id="writing" data-section="writing" class="py-24 md:py-32" aria-labelledby="writing-title">
    <div class="container-wide">
      <SectionHead id="writing-title" num="03" title={copy.writing.title} eyebrow={copy.writing.eyebrow}>
        <a href="/blog" class="link-arrow py-1.5" data-astro-reload>
          See all posts <Icon name="arrow-right" class="nudge h-4 w-5" />
        </a>
      </SectionHead>
      {
        posts.length > 0 ? (
          <ul class="grid items-stretch gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-7">
            {posts.map((post, i) => {
              const date = new Date(post.publishedAt ?? post.createdAt)
              return (
                <li>
                  <a
                    href={`/blog/${post.slug}`}
                    class="card lift group relative flex h-full flex-col overflow-hidden p-6"
                    data-astro-reload
                    data-reveal="up"
                    data-delay={String(i * 0.08)}
                  >
                    <div class="lift__hex hex pointer-events-none absolute -top-6 -right-6 aspect-[1.15] w-20 bg-apricot/60" aria-hidden="true" />
                    <p class="relative mb-4 flex items-center gap-1.5 type-subtitle text-[11px] text-muted">
                      <Icon name="calendar" class="h-3.5 w-3.5 text-teal" />
                      <time datetime={date.toISOString()}>{formatDate(post.publishedAt ?? post.createdAt)}</time>
                    </p>
                    <h3 class="lift__title relative type-h4 text-heading">{post.title}</h3>
                    {post.description && <p class="mt-2 line-clamp-3 text-sm text-body">{post.description}</p>}
                    <div class="mt-auto pt-5">
                      {post.tags.length > 0 && (
                        <div class="mb-4 flex flex-wrap gap-1.5">
                          {post.tags.map((tag, j) => (
                            <span class:list={['tag', j > 0 && 'tag-outline']}>{tag.name}</span>
                          ))}
                        </div>
                      )}
                      <hr class="hairline mb-3" />
                      <span class="link-arrow text-[13px]">
                        Read article <Icon name="arrow-right" class="nudge h-4 w-5" />
                      </span>
                    </div>
                  </a>
                </li>
              )
            })}
          </ul>
        ) : (
          <p class="text-body">The first post is still in draft.</p>
        )
      }
    </div>
  </section>

  <Connect email={email} links={links} />
</V2>
