---
import V2 from '../../../v2/layouts/V2.astro'
import NotFound from '../../../v2/components/NotFound.astro'
import { loadResume, projectsOf, site, srcset, tones } from '../../../v2/data/content'

const resume = await loadResume()
const { all } = projectsOf(resume)
const i = all.findIndex((p) => p.slug === Astro.params.slug)
const p = i > -1 ? all[i] : null
if (!p) Astro.response.status = 404

const next = all.length > 1 ? all[(i + 1) % all.length] : null
const company = p?.company === 'Icon Plus' ? 'PLN Icon Plus' : p?.company
const kind = p ? (p.type === 'work' ? `Work at ${company ?? 'work'}` : 'Side project') : ''
const realLink = p?.link?.href && p.link.href !== '#' ? p.link : undefined
const linkLabel = (href: string) =>
  href.includes('github.com') ? 'View on GitHub' : `Visit ${p?.title ?? 'the site'}`
const description = p
  ? (p.description.length >= 60 ? p.description : p.detail).slice(0, 160)
  : ''
const schema = p
  ? {
      '@context': 'https://schema.org',
      '@type': p.type === 'work' ? 'CreativeWork' : 'SoftwareSourceCode',
      name: p.title,
      abstract: p.description,
      keywords: p.techStack.join(', '),
      creator: { '@type': 'Person', name: site.fullName },
      ...(realLink ? { url: realLink.href } : {}),
    }
  : undefined
---

{
  p ? (
    <V2 title={`${p.title}, ${kind.toLowerCase()}`} description={description} current="work" schema={schema}>
      <article class="case">
        <header class="case__hero">
          <p class="case__kind mono">{kind}</p>
          <h1 class="case__title display" data-split="words" data-intro>{p.title}</h1>
          <p class="case__summary" data-split="lines" data-intro data-delay="0.3">{p.description}</p>
          <dl class="case__meta" data-reveal="fade" data-intro data-delay="0.5">
            <div><dt>Type</dt><dd>{p.type === 'work' ? 'Work' : 'Side project'}</dd></div>
            <div><dt>{p.type === 'work' ? 'Company' : 'Author'}</dt><dd>{company ?? site.name}</dd></div>
            {p.techStack.length > 0 && (
              <div class="case__meta-wide"><dt>Stack</dt><dd>{p.techStack.join(', ')}</dd></div>
            )}
          </dl>
          {realLink && (
            <p class="case__cta" data-reveal="fade" data-intro data-delay="0.6">
              <a class="pill pill--light" href={realLink.href} rel="noopener">
                <span>{linkLabel(realLink.href)}</span>
                <span class="pill__arrow" aria-hidden="true">↗</span>
              </a>
            </p>
          )}
        </header>

        {p.cover && (
          <figure class="case__shot" data-reveal="up">
            <img src={p.cover} srcset={srcset(p.cover)} sizes="100vw" width="1920" height="1000" alt={`Screenshot of ${p.title}`} decoding="async" fetchpriority="high" />
          </figure>
        )}

        <section class="case__section case__section--idea" aria-labelledby="about">
          <h2 id="about" class="case__h">About the project</h2>
          <p class="case__text case__text--big" data-split="lines">{p.detail}</p>
        </section>

        {p.techStack.length > 0 && (
          <section class="case__section" aria-labelledby="stack">
            <h2 id="stack" class="case__h">Built with</h2>
            <ul class="chips chips--lg case__chips">
              {p.techStack.map((s, j) => (
                <li class={`chip chip--${tones[(j + i) % 5]}`}>{s}</li>
              ))}
            </ul>
          </section>
        )}

        {next && (
          <nav class="next" aria-label="Next project">
            <a class="next__link" href={`/v2/work/${next.slug}`}>
              <span class="next__label mono">Next project</span>
              <span class="next__title">{next.title}</span>
              <span class="next__kind">{next.description}</span>
              <span class="next__track" aria-hidden="true"><span /></span>
            </a>
          </nav>
        )}
      </article>
    </V2>
  ) : (
    <V2 title="Not found" description="This project isn’t part of Brendatama’s portfolio. The home page lists every project and the work history.">
      <NotFound />
    </V2>
  )
}
