---
import PostPage from '../../../components/PostPage.astro'
import { api } from '../../../lib/api'

const { slug } = Astro.params

// The API already falls back to English fields when a translation is missing
let data
try {
  data = await api.getPost(slug!, 'id')
} catch {
  return Astro.redirect('/id/blog', 302)
}
---

<PostPage {data} lang="id" />
