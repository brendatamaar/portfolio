---
import BlogIndex from '../../../components/BlogIndex.astro'
import { api } from '../../../lib/api'
import type { PostSummary } from '../../../lib/types'

const posts = await api
  .getPosts('id', 100)
  .then((r) => r.data)
  .catch(() => [] as PostSummary[])
---

<BlogIndex
  {posts}
  lang="id"
  title="Tulisan | Brendatama Akbar"
  heading="Tulisan"
  description="Tulisan tentang perangkat lunak, desain, dan web."
  allLabel="Semua"
  emptyLabel="Belum ada tulisan."
/>
