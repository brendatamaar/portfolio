---
import V2 from '../v2/layouts/V2.astro'
import '../v2/styles/blog.css'
import Sticker from '../v2/components/Sticker.astro'
import { api } from '../lib/api'
import type { PostSummary, PostTag } from '../lib/types'
import { formatDate, site } from '../v2/data/content'

const posts = await api
  .getPosts('en', 100)
  .then((r) => r.data)
  .catch(() => [] as PostSummary[])

// Unique tags across all posts, in first-seen order
const tags = [
  ...new Map(posts.flatMap((p) => p.tags).map((t): [string, PostTag] => [t.slug, t])).values(),
]
const cardTones = ['orange', 'lavender', 'lime', 'coral', 'green'] as const
---

<V2 title="Writing" description="Writing on software, design, and the web." current="blog">
  <header class="blog-head blog-head--mast">
    <p class="blog-mast__meta mono" data-reveal="fade" data-intro>
      <span>{site.location}</span>
      <span>{posts.length} {posts.length === 1 ? 'post' : 'posts'}</span>
    </p>
    <h1 class="blog-head__title" data-split="words" data-intro>Writing</h1>
    <p class="blog-head__intro" data-reveal="fade" data-intro data-delay="0.3">
      Notes on software, design, and the web.
    </p>
    {
      tags.length > 0 && (
        <div class="blog-filter" data-blog-filter role="group" aria-label="Filter by tag" data-reveal="fade">
          <button type="button" class="blog-filter__btn" data-tag="" aria-pressed="true">
            All
          </button>
          {tags.map((tag) => (
            <button type="button" class="blog-filter__btn" data-tag={tag.slug} aria-pressed="false">
              {tag.name}
            </button>
          ))}
        </div>
      )
    }
  </header>

  <section class="blog-list" aria-label="Posts">
    {
      posts.length > 0 ? (
        <ul class="posts">
          {posts.map((post, i) => (
            <li data-post-item data-tags={post.tags.map((t) => t.slug).join(',')} data-reveal="up">
              <a
                class={`post-card card--${cardTones[i % cardTones.length]} bite`}
                href={`/blog/${post.slug}`}
                style="--bite: var(--c-bg)"
              >
                <span class="post-card__meta">
                  {formatDate(post.publishedAt ?? post.createdAt)}
                  {post.tags.length > 0 && ` · ${post.tags.map((t) => t.name).join(', ')}`}
                </span>
                <span class="post-card__title">{post.title}</span>
                {post.description && <span class="post-card__desc">{post.description}</span>}
                <span class="bite__btn" aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <div class="scrap__empty" data-reveal="up">
          <Sticker kind="sparkle" color="#d7ec4a" class="scrap__empty-deco scrap__empty-deco--a" />
          <Sticker kind="star" color="#ff8a1e" class="scrap__empty-deco scrap__empty-deco--b" />
          <Sticker kind="squiggle" color="#9c8cff" class="scrap__empty-deco scrap__empty-deco--c" />
          <Sticker kind="seal" class="scrap__empty-seal" />
          <p class="scrap__empty-title display">Nothing here yet</p>
          <p class="scrap__empty-text">New writing is on its way. Check back soon.</p>
        </div>
      )
    }
  </section>
</V2>
