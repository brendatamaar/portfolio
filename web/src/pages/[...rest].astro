---
import Page from '../folio/components/Page.astro'
import NotFound from '../folio/components/NotFound.astro'
import { blog, type Lang } from '../folio/data/content'

Astro.response.status = 404
// Unknown addresses under /id get the Indonesian 404
const lang: Lang = /^\/id(\/|$)/.test(Astro.url.pathname) ? 'id' : 'en'
const t = blog[lang]
---

<Page lang={lang} title={t.notFoundTitle} description={t.notFoundDescription}>
  <NotFound lang={lang} />
</Page>
