---
import V2 from '../v2/layouts/V2.astro'
import Waterfall from '../v2/components/Waterfall.astro'
import Sticker from '../v2/components/Sticker.astro'
import Logo from '../v2/components/Logo.astro'
import {
  copy,
  formatDate,
  loadPosts,
  loadResume,
  projectsOf,
  site,
  socials,
  srcset,
  tones,
} from '../v2/data/content'

const [resume, posts] = await Promise.all([loadResume(), loadPosts(8)])
const { work: workProjects, side: sideProjects, all } = projectsOf(resume)
const projectUrl = (p: (typeof all)[number]) =>
  p.link?.href && p.link.href !== '#' ? p.link.href : undefined
const profile = resume.profile
const name = profile?.name ?? site.fullName
const firstName = name.split(' ')[0]
const location = profile?.location ?? site.location
const city = location.split(',')[0]
const role = profile?.currentJob ?? site.role
const email = profile?.email ?? site.email
const links = socials(resume)
const github = links.find((s) => s.label === 'GitHub')
const since = resume.work.length
  ? Math.min(...resume.work.map((w) => Number(w.start)).filter(Boolean))
  : null
const firstCompany = workProjects[0]?.company
const companyName = (c?: string) => (c === 'Icon Plus' ? 'PLN Icon Plus' : c)
const coverTones = ['orange', 'lavender', 'green', 'coral'] as const
const chipTones = ['lime', 'lavender', 'orange', 'green', 'coral'] as const
const fanTilts = ['-7deg', '-3.5deg', '2deg', '5deg', '-2deg', '6.5deg'] as const
const fanLifts = ['1.2rem', '0rem', '1.6rem', '0.2rem', '1.4rem', '0rem'] as const
const scrapTones = ['orange', 'lavender', 'lime', 'coral', 'green'] as const
const scrapStickers = [
  { kind: 'sparkle', color: '#ffffff' },
  { kind: 'star', color: '#d7ec4a' },
  { kind: 'squiggle', color: '#9c8cff' },
] as const
const scrapTilts = ['-1.6deg', '1.3deg', '-0.9deg', '1.7deg', '-1.2deg', '0.8deg', '-1.9deg'] as const
const stepTones = ['orange', 'lavender', 'green', 'coral', 'lime'] as const
const stepStickers = [
  { kind: 'sparkle', color: '#ffffff' },
  { kind: 'star', color: '#d7ec4a' },
  { kind: 'squiggle', color: '#ff8a1e' },
  { kind: 'bolt', color: '#ffffff' },
  { kind: 'seal', color: '#d7ec4a' },
] as const
const total = sideProjects.length
const mid = Math.floor((total - 1) / 2)
const [lead, ...rest] = posts
---

<V2 current="home">
  <!-- Hero -->
  <section class="hero band band--navy" aria-labelledby="hero-title">
    <p class="hero__eyebrow hero__rise" style="--i:0">
      <span class="hero__heart" aria-hidden="true">●</span>
      {location}
    </p>
    <h1 id="hero-title" class="hero__title display">
      <span class="hero__line" style="--i:0">Hi, I’m <span class="ink-orange">{firstName}.</span></span>
      <span class="hero__line ink-lavender" style="--i:1">{role}</span>
      <span class="hero__line" style="--i:2">based in {city}.</span>
    </h1>
    {profile?.summary && <p class="hero__sub hero__rise" style="--i:3">{profile.summary}</p>}
    <div class="hero__ctas hero__rise" style="--i:4">
      <a class="pill pill--light" href={site.resume} download data-astro-reload>
        <span>Download Resume</span><span class="pill__arrow" aria-hidden="true">↓</span>
      </a>
      <a class="pill pill--ghost" href={`mailto:${email}`}>
        <span>Send an email</span><span class="pill__arrow" aria-hidden="true">→</span>
      </a>
    </div>
    <p class="hero__find hero__rise" style="--i:5">
      <span>Find me on</span>
      {links.map((s) => <a class="chip chip--dark" href={s.href} rel="me noopener">{s.label} ↗</a>)}
    </p>

    <Sticker kind="squiggle" color="#ff8a1e" class="hero__s1" />
    <Sticker kind="seal" class="hero__s2" />
    <Sticker kind="sparkle" color="#e9ecf5" class="hero__s3" />
    <Sticker kind="star" color="#d7ec4a" class="hero__s4" />
    <Sticker kind="sparkle" color="#9c8cff" class="hero__s5" />

    <!-- <div class="hero__foot">
      <div class="hero__claim">
        <div class="tags" aria-hidden="true">
          <span class="tag tag--orange" data-pop style="--r:-8deg">200 OK</span>
          <span class="tag tag--coral" data-pop style="--r:4deg">cache hit</span>
          <span class="tag tag--lime" data-pop style="--r:-3deg">loaded in <span data-live-ms>live</span></span>
        </div>
        <p class="hero__claim-text">This page measured itself. <span>Every request it took to reach you is listed below, live.</span></p>
      </div>
      {
        since && (
          <a class="stat stat--green bite" href="#work" style="--bite: var(--c-navy)">
            <span class="stat__num">Since {since}</span>
            <span class="stat__label">building for the web, from front-end to full stack</span>
            <span class="bite__btn" aria-hidden="true">↗</span>
          </a>
        )
      }
      {
        all.length > 0 && (
          <a class="stat stat--lime bite" href="#projects" style="--bite: var(--c-navy)">
            <span class="stat__num">{all.length} projects</span>
            <span class="stat__label">side projects and work, listed on this page</span>
            <span class="bite__btn" aria-hidden="true">↗</span>
          </a>
        )
      }
    </div> -->
  </section>

  <!-- 01 Projects -->
  <section class="section" id="projects" aria-labelledby="projects-title">
    <div class="section__head">
      <div>
        <p class="eyebrow">{copy.projects.eyebrow}</p>
        <h2 id="projects-title" class="display section__title" data-split="lines">{copy.projects.title}</h2>
      </div>
      <p class="section__note">{copy.projects.note}</p>
    </div>
    <ul class="fan fan--side" data-fan style={`--n:${total}`}>
      {
        sideProjects.map((p, i) => (
          <li
            class="fan__item"
            data-fan-item
            data-active={i === mid ? '' : undefined}
            data-reveal="up"
            data-delay={String(i * 0.06)}
            style={`--i:${i};--r:${fanTilts[i % fanTilts.length]};--y:${fanLifts[i % fanLifts.length]}`}
          >
            <a
              class={`fan__card cover--${coverTones[i % coverTones.length]}`}
              href={projectUrl(p)}
              target={projectUrl(p) ? '_blank' : undefined}
              rel={projectUrl(p) ? 'noopener' : undefined}
            >
              {p.cover ? (
                <img
                  class="fan__img"
                  src={p.cover}
                  srcset={srcset(p.cover)}
                  sizes="(max-width: 639px) 82vw, 34vw"
                  width="1920"
                  height="1080"
                  alt={`Screenshot of ${p.title}`}
                  loading="lazy"
                  fetchpriority="low"
                  decoding="async"
                />
              ) : (
                <span class="proj__bars" aria-hidden="true">
                  {p.techStack.slice(0, 4).map((s, j) => (
                    <span class="proj__bar" style={`--j:${j}`}>
                      <span>{s}</span>
                    </span>
                  ))}
                </span>
              )}
              <span class="fan__cap">
                <span class="fan__title display">{p.title}</span>
                <span class="fan__desc">{p.description}</span>
              </span>
              {projectUrl(p) && <span class="bite__btn" aria-hidden="true">↗</span>}
            </a>
          </li>
        ))
      }
    </ul>
    {
      github && (
        <div class="fan__more">
          <a class="pill pill--dark" href={github.href} rel="me noopener">
            <span>More on GitHub</span><span class="pill__arrow" aria-hidden="true">→</span>
          </a>
        </div>
      )
    }
  </section>

  <!-- 02 Work -->
  <section class="section" id="work" aria-labelledby="work-title">
    <div class="section__head section__head--single">
      <p class="eyebrow">{copy.work.eyebrow}</p>
      <h2 id="work-title" class="display section__title" data-split="lines">{copy.work.title}</h2>
    </div>
    <ol class="steps">
      {
        resume.work.map((w, i) => {
          const url = w.link && w.link !== '#' ? w.link : undefined
          const sticker = stepStickers[i % stepStickers.length]
          const inner = (
            <Fragment>
              <span class="step__title display">
                {w.company}
                <span class="step__role">{w.title}</span>
                <span class="step__date">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15.5" rx="1.5" /><path d="M3.5 10h17M8 3v4M16 3v4" /></svg>
                  {w.start} – {w.end}
                </span>
              </span>
              <span class="step__text">{w.description}</span>
              <Sticker kind={sticker.kind} color={sticker.color} class="step__sticker" />
              {url && <span class="bite__btn" aria-hidden="true">↗</span>}
            </Fragment>
          )
          return (
            <li class="step">
              {url ? (
                <a
                  class={`step__card step__card--${stepTones[i % stepTones.length]} bite`}
                  style="--bite: var(--c-bg)"
                  href={url}
                  target="_blank"
                  rel="noopener"
                  aria-label={`Visit ${w.company} (opens in a new tab)`}
                >
                  {inner}
                </a>
              ) : (
                <article class={`step__card step__card--${stepTones[i % stepTones.length]}`}>{inner}</article>
              )}
            </li>
          )
        })
      }
    </ol>
    {
      resume.skills.length > 0 && (
        <div class="stack">
          <p class="eyebrow" id="stack-label">Tech stack</p>
          <div class="marquee">
            <div class="marquee__track">
              <ul class="chips chips--lg marquee__group" aria-labelledby="stack-label">
                {resume.skills.map((t, i) => (
                  <li class={`chip chip--${chipTones[i % chipTones.length]}`}>{t}</li>
                ))}
              </ul>
              <ul class="chips chips--lg marquee__group" aria-hidden="true">
                {resume.skills.map((t, i) => (
                  <li class={`chip chip--${chipTones[i % chipTones.length]}`}>{t}</li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      )
    }
  </section>

  <!-- Statement band -->
  <section class="section" aria-label="How I build">
    <div class="banner bite" style="--bite: var(--c-bg)" data-reveal="up">
      <span class="tag tag--orange banner__t1" data-pop style="--r:-6deg" aria-hidden="true">{copy.banner.tags[0]}</span>
      <span class="tag tag--green banner__t2" data-pop style="--r:5deg" aria-hidden="true">{copy.banner.tags[2]}</span>
      <span class="tag tag--coral banner__t3" data-pop style="--r:-4deg" aria-hidden="true">{copy.banner.tags[1]}</span>
      <p class="banner__text display">{copy.banner.title}</p>
      <p class="banner__note">{copy.banner.note}</p>
      <Logo class="banner__logo" />
      <Sticker kind="sparkle" color="#0e1a2b" class="banner__s1" />
      <Sticker kind="star" color="#ff8a1e" class="banner__s2" />
    </div>
  </section>

  <!-- Selected work -->
  {
    workProjects.length > 0 && (
      <section class="section" id="selected" aria-labelledby="selected-title">
        <div class="section__head">
          <div>
            {firstCompany && <p class="eyebrow">Built at {companyName(firstCompany)}</p>}
            <h2 id="selected-title" class="display section__title" data-split="lines">
              {copy.selected.title}
            </h2>
          </div>
          <div class="rail__ctrl">
            <button class="round" type="button" data-rail-prev aria-label="Previous projects">←</button>
            <button class="round" type="button" data-rail-next aria-label="Next projects">→</button>
          </div>
        </div>
        <ul class="rail" data-rail>
          {workProjects.map((p, i) => (
            <li class="proj" data-reveal="up" data-delay={String(i * 0.06)}>
              <a
                class="proj__link"
                href={projectUrl(p)}
                target={projectUrl(p) ? '_blank' : undefined}
                rel={projectUrl(p) ? 'noopener' : undefined}
              >
                <span class={`proj__cover cover--${coverTones[i % coverTones.length]}`}>
                  {p.cover ? (
                    <img
                      class="proj__img"
                      src={p.cover}
                      srcset={srcset(p.cover)}
                      sizes="(max-width: 639px) 82vw, 30vw"
                      width="1920"
                      height="1080"
                      alt={`Screenshot of ${p.title}`}
                      loading="lazy"
                      fetchpriority="low"
                      decoding="async"
                    />
                  ) : (
                    <span class="proj__bars" aria-hidden="true">
                      {p.techStack.slice(0, 4).map((s, j) => (
                        <span class="proj__bar" style={`--j:${j}`}>
                          <span>{s}</span>
                        </span>
                      ))}
                    </span>
                  )}
                </span>
                <span class="proj__head">
                  <span class="proj__title display">{p.title}</span>
                  {projectUrl(p) && <span class="bite__btn" aria-hidden="true">↗</span>}
                </span>
                <span class="proj__kind">{p.description}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <!-- 03 Writing -->
  <section class="section" aria-labelledby="blog-title">
    <div class="section__head">
      <div>
        <p class="eyebrow">{copy.writing.eyebrow}</p>
        <h2 id="blog-title" class="display section__title" data-split="lines">{copy.writing.title}</h2>
      </div>
      <a class="pill pill--dark" href="/blog">
        <span>See all posts</span><span class="pill__arrow" aria-hidden="true">→</span>
      </a>
    </div>
    {
      lead ? (
        <div class="scrap">
          <div data-reveal="up">
            <a class="scrap__lead bite" href={`/blog/${lead.slug}`} style="--bite: var(--c-bg);--r:-1deg">
              <span class="tag tag--lime scrap__tag" style="--r:-4deg">Latest</span>
              <span class="scrap__meta mono">
                {formatDate(lead.publishedAt ?? lead.createdAt)}
                {lead.tags.length > 0 && ` · ${lead.tags.map((t) => t.name).join(', ')}`}
              </span>
              <span class="scrap__lead-title display">{lead.title}</span>
              {lead.description && <span class="scrap__desc">{lead.description}</span>}
              <Sticker kind="seal" class="scrap__lead-seal" />
              <Sticker kind="sparkle" color="#e9ecf5" class="scrap__lead-sparkle" />
              <Sticker kind="star" color="#d7ec4a" class="scrap__lead-star" />
              <span class="bite__btn" aria-hidden="true">↗</span>
            </a>
          </div>
          {rest.length > 0 && (
            <ul class="scrap__grid">
              {rest.map((p, i) => (
                <li data-reveal={i < 3 ? 'up' : undefined} hidden={i >= 3 || undefined} data-scrap-extra={i >= 3 || undefined}>
                  <a
                    class={`scrap__card scrap--${scrapTones[i % scrapTones.length]} bite`}
                    href={`/blog/${p.slug}`}
                    style={`--bite: var(--c-bg);--r:${scrapTilts[i % scrapTilts.length]}`}
                  >
                    <span class="scrap__meta mono">
                      {formatDate(p.publishedAt ?? p.createdAt)}
                      {p.tags.length > 0 && ` · ${p.tags.map((t) => t.name).join(', ')}`}
                    </span>
                    <span class="scrap__card-title">{p.title}</span>
                    <Sticker kind={scrapStickers[i % scrapStickers.length].kind} color={scrapStickers[i % scrapStickers.length].color} class="scrap__sticker" />
                    <span class="bite__btn" aria-hidden="true">↗</span>
                  </a>
                </li>
              ))}
            </ul>
          )}
          {rest.length > 3 && (
            <div class="scrap__more">
              <button class="pill pill--dark" type="button" data-scrap-more aria-expanded="false">
                <span>Read more</span><span class="pill__arrow" aria-hidden="true">↓</span>
              </button>
            </div>
          )}
        </div>
      ) : (
        <div class="scrap__empty" data-reveal="up">
          <Sticker kind="sparkle" color="#d7ec4a" class="scrap__empty-deco scrap__empty-deco--a" />
          <Sticker kind="star" color="#ff8a1e" class="scrap__empty-deco scrap__empty-deco--b" />
          <Sticker kind="squiggle" color="#9c8cff" class="scrap__empty-deco scrap__empty-deco--c" />
          <Sticker kind="seal" class="scrap__empty-seal" />
          <p class="scrap__empty-title display">Nothing here yet</p>
          <p class="scrap__empty-text">The first writing are being drafted, check back soon.</p>
          <a class="pill pill--light" href="/blog">
            <span>Visit the blog</span><span class="pill__arrow" aria-hidden="true">→</span>
          </a>
        </div>
      )
    }
  </section>

  <!-- Live waterfall (last, right before the footer) -->
  <section class="section live" id="live" aria-labelledby="live-title">
    <div class="section__head">
      <div>
        <p class="eyebrow">{copy.live.eyebrow}</p>
        <h2 id="live-title" class="display section__title" data-split="lines">{copy.live.title}</h2>
      </div>
      <p class="section__note">{copy.live.note}</p>
    </div>
    <div class="live__stage">
      <div class="live__card bite" style="--bite: var(--c-bg)" data-reveal="up">
        <Waterfall />
        <span class="bite__btn bite__btn--static" aria-hidden="true"><span class="live__pulse"></span></span>
      </div>
      <p class="live__float live__float--a" data-pop><span class="stat__num" data-stat="ms">live</span><span>to load, end to end</span></p>
      <p class="live__float live__float--b" data-pop><span class="stat__num" data-visit>open</span><span>you, still connected</span></p>
    </div>
  </section>

</V2>
