---
import Base from '../layouts/Base.astro'
import SectionLabel from '../components/SectionLabel.astro'
import PostCard from '../components/PostCard.astro'
import ProjectCard from '../components/ProjectCard.astro'
import Icon from '../components/Icon.astro'
import { api } from '../lib/api'
import type { PostSummary, ResumeData, ResumeProjectItem } from '../lib/types'

const BLOG_PREVIEW = 3
const PROJECT_PREVIEW = 4

const [postsRes, resumeRes] = await Promise.allSettled([
  api.getPosts('en', BLOG_PREVIEW).then((r) => r.data),
  api.getResumeData('en'),
])

const posts: PostSummary[] = postsRes.status === 'fulfilled' ? postsRes.value : []
const resume: ResumeData = resumeRes.status === 'fulfilled'
  ? resumeRes.value
  : { profile: null, work: [], education: [], skills: [], projects: [] }

const sideProjects: ResumeProjectItem[] = resume.projects.filter((p) => p.type === 'side_project')
const workProjectsByCompany: Record<string, ResumeProjectItem[]> = {}
for (const p of resume.projects) {
  if (p.type === 'work' && p.company) {
    if (!workProjectsByCompany[p.company]) workProjectsByCompany[p.company] = []
    workProjectsByCompany[p.company].push(p)
  }
}

const visibleProjects = sideProjects.slice(0, PROJECT_PREVIEW)
const remaining = sideProjects.length - PROJECT_PREVIEW
const profile = resume.profile
const [firstName, ...restName] = profile?.name.split(' ') ?? []
---

<Base
  title="Brendatama Akbar — Web Software Developer"
  description="Web Software Developer based in Jakarta, Indonesia."
>
  <!-- Hero -->
  {profile && (
    <section class="relative mb-20">
      <!-- Hive pattern behind the role card + one dot pattern -->
      <div class="pointer-events-none absolute -top-8 -right-12 hidden aspect-[1.15] w-44 sm:block" aria-hidden="true">
        <div class="hex h-full w-full bg-butter"></div>
      </div>
      <div class="hex pointer-events-none absolute top-56 -right-16 hidden aspect-[1.15] w-10 bg-lilac sm:block" aria-hidden="true"></div>
      <div class="dots pointer-events-none absolute top-40 right-2 hidden h-20 w-36 text-teal/40 sm:block" aria-hidden="true"></div>

      <div class="relative mb-8 flex flex-col gap-6 sm:flex-row sm:items-start">
        <div class="flex flex-1 flex-col items-start gap-6">
          <h1 class="type-h1 text-heading">
            <span class="text-peach">{firstName}</span> {restName.join(' ')}
          </h1>
          <a href="/pdf/Resume Brendatama Akbar (2026) - English.pdf" download class="btn btn-primary">
            <Icon name="download" class="h-4 w-4" strokeWidth={2} />
            Download Resume
          </a>
        </div>

        <div class="panel shrink-0 self-start shadow-raised sm:w-48">
          <div class="border-b border-line-soft px-4 py-3">
            <p class="mb-0.5 type-subtitle text-[10px] text-muted">Role</p>
            <p class="text-sm font-semibold text-heading">{profile.currentJob}</p>
          </div>
          <div class="px-4 py-3">
            <p class="mb-0.5 type-subtitle text-[10px] text-muted">Location</p>
            <p class="flex items-center gap-1 text-sm font-semibold text-heading">
              <Icon name="pin" class="h-3.5 w-3.5 shrink-0 text-teal" />
              {profile.location}
            </p>
          </div>
        </div>
      </div>

      <div class="relative border-t border-line pt-6">
        <p class="text-body">{profile.summary}</p>
      </div>
    </section>
  )}

  <div class="space-y-20">
    <!-- 01 — Projects -->
    <section id="projects" data-section="projects">
      <SectionLabel num="01" label="Projects" />
      <div class="grid grid-cols-1 items-stretch gap-4 sm:grid-cols-2">
        {visibleProjects.map((project, i) => (
          <ProjectCard project={project} index={i} />
        ))}
      </div>
      {remaining > 0 && (
        <div class="mt-6">
          <button
            id="show-more-projects"
            type="button"
            data-remaining={remaining}
            aria-expanded="false"
            aria-controls="extra-projects"
            class="btn btn-outline"
          >
            +{remaining} more projects
          </button>
          <div id="extra-projects" class="mt-4 hidden grid-cols-1 items-stretch gap-4 sm:grid-cols-2">
            {sideProjects.slice(PROJECT_PREVIEW).map((project, i) => (
              <ProjectCard project={project} index={PROJECT_PREVIEW + i} />
            ))}
          </div>
        </div>
      )}
    </section>

    <!-- 02 — Work -->
    <section id="work" data-section="work">
      <SectionLabel num="02" label="Work" />
      <div>
        {resume.work.map((work, i) => {
          const companyProjects = workProjectsByCompany[work.company]
          const isLast = i === resume.work.length - 1
          const isCurrent = work.end.toLowerCase() === 'now'
          return (
            <div class={isLast ? '' : 'border-b border-line-soft'}>
              <div class="py-5">
                <div class="flex items-baseline justify-between gap-2">
                  <span class="flex items-center gap-2.5 type-h4 text-heading">
                    <span
                      class:list={['hex aspect-[1.15] w-3 shrink-0', isCurrent ? 'bg-teal' : 'bg-grey-300']}
                      aria-hidden="true"
                    ></span>
                    {work.company}
                  </span>
                  <span class="shrink-0 font-mono text-[11px] text-muted tabular-nums">
                    {work.start}–{work.end}
                  </span>
                </div>
                <div class="pl-[22px]">
                  <p class="mb-2 type-subtitle text-[11px] text-muted">{work.title}</p>
                  <p class="text-sm text-body">{work.description}</p>
                  {companyProjects && (
                    <button
                      type="button"
                      class="work-toggle mt-3 inline-flex items-center gap-1 text-[13px] font-bold text-link hover:underline"
                      data-company={work.company}
                      aria-expanded="false"
                    >
                      <span>See projects</span>
                      <Icon name="chevron-down" class="h-3.5 w-3.5 transition-transform" strokeWidth={2} />
                    </button>
                  )}
                </div>
              </div>
              {companyProjects && (
                <div
                  class="work-projects overflow-hidden transition-[max-height] duration-300"
                  data-company={work.company}
                  style="max-height: 0"
                >
                  <div class="grid grid-cols-1 items-stretch gap-4 pb-5 sm:grid-cols-2">
                    {companyProjects.map((project, j) => (
                      <ProjectCard project={project} index={j} />
                    ))}
                  </div>
                </div>
              )}
            </div>
          )
        })}
      </div>
    </section>

    <!-- 03 — Writing -->
    <section id="writing" data-section="writing">
      <SectionLabel num="03" label="Writing" />
      {posts.length > 0 ? (
        <div class="flex flex-col gap-4">
          {posts.map((post) => <PostCard post={post} />)}
        </div>
      ) : (
        <div class="panel flex items-center gap-5 p-6">
          <div class="hex aspect-[1.15] w-12 shrink-0 bg-butter" aria-hidden="true"></div>
          <div>
            <p class="font-bold text-heading">No posts yet.</p>
            <p class="text-sm text-muted">The first essays are being drafted — check back soon.</p>
          </div>
        </div>
      )}
      <div class="mt-6">
        <a href="/blog" class="btn btn-outline">
          All posts
          <Icon name="arrow-right" class="h-4 w-4" strokeWidth={2} />
        </a>
      </div>
    </section>

    <!-- 04 — Connect -->
    {profile?.social && profile.social.length > 0 && (
      <section id="connect" data-section="connect">
        <SectionLabel num="04" label="Connect" />
        <!-- Promo-banner style block with hive pattern -->
        <div class="relative overflow-hidden rounded-xs bg-sunken px-6 py-8 sm:px-10 sm:py-10">
          <div class="hex-tilt pointer-events-none absolute -top-10 -right-6 hidden aspect-[1.15] w-44 bg-butter sm:block" aria-hidden="true"></div>
          <div class="hex pointer-events-none absolute right-20 bottom-5 hidden aspect-[1.15] w-12 bg-teal sm:block" aria-hidden="true"></div>
          <div class="hex pointer-events-none absolute right-5 bottom-20 hidden aspect-[1.15] w-8 bg-lilac sm:block" aria-hidden="true"></div>

          <p class="relative mb-8 max-w-sm text-body sm:text-base">
            I'm always open to interesting conversations, collaborations, and opportunities.
          </p>
          <div class="relative flex flex-wrap gap-3 sm:max-w-[75%]">
            {profile.social.map((link, i) => (
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class:list={['btn', i === 0 ? 'btn-primary' : 'btn-outline']}
              >
                {link.name}
                <Icon name="external" class="h-4 w-4" strokeWidth={2} />
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </div>
</Base>

<script>
  import { onPageLoad } from '../scripts/lifecycle'

  onPageLoad(() => {
    // Show more projects toggle
    const showMoreBtn = document.getElementById('show-more-projects')
    const extraProjects = document.getElementById('extra-projects')
    if (showMoreBtn && extraProjects) {
      showMoreBtn.addEventListener('click', () => {
        const expanded = showMoreBtn.getAttribute('aria-expanded') !== 'true'
        showMoreBtn.setAttribute('aria-expanded', String(expanded))
        extraProjects.classList.toggle('hidden', !expanded)
        extraProjects.classList.toggle('grid', expanded)
        const remaining = showMoreBtn.dataset.remaining ?? '0'
        showMoreBtn.textContent = expanded ? 'Show less' : `+${remaining} more projects`
      })
    }

    // Work expand/collapse
    document.querySelectorAll<HTMLButtonElement>('.work-toggle').forEach((btn) => {
      btn.addEventListener('click', () => {
        const company = btn.dataset.company!
        const panel = document.querySelector<HTMLElement>(`.work-projects[data-company="${CSS.escape(company)}"]`)
        if (!panel) return
        const open = btn.getAttribute('aria-expanded') === 'true'
        btn.setAttribute('aria-expanded', String(!open))
        const svg = btn.querySelector('svg')
        if (svg) svg.style.transform = open ? '' : 'rotate(180deg)'
        const label = btn.querySelector('span')
        if (label) label.textContent = open ? 'See projects' : 'Hide projects'
        panel.style.maxHeight = open ? '0' : `${panel.scrollHeight}px`
      })
    })
  })
</script>
