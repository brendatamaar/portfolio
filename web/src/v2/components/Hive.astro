---
// A tessellated honeycomb of flat-top hexagons. Cells are pastel fills, outlines, or real project
// screenshots. Decorative: the same projects are linked in the page below.
// Geometry: a cell of width w steps 0.75w across; odd columns drop half a cell.
export type Cell = {
  col: number
  row: number
  kind: 'butter' | 'apricot' | 'teal' | 'lilac' | 'peach' | 'navy' | 'outline' | 'shot'
  img?: string
  /** pointer parallax strength, 0..1 */
  depth?: number
}
interface Props {
  cells: Cell[]
  class?: string
  /** play the pop-in with the page intro (hero) instead of on scroll */
  intro?: boolean
}
const { cells, class: className = '', intro = false } = Astro.props

const cols = Math.max(...cells.map((c) => c.col)) + 1
const rows = Math.max(...cells.map((c) => c.row + (c.col % 2 ? 0.5 : 0))) + 1
const W = 100 / (0.75 * cols + 0.25) // cell width, % of hive width
const H = W / 1.15 // cell height in the same unit
const widthUnits = 0.75 * cols + 0.25
const heightUnits = rows / 1.15
const fill: Record<string, string> = {
  butter: 'bg-butter',
  apricot: 'bg-apricot',
  teal: 'bg-teal',
  lilac: 'bg-lilac',
  peach: 'bg-peach',
  navy: 'bg-navy dark:bg-navy-2',
}
---

<div
  class:list={['hive', !/\b(absolute|fixed)\b/.test(className) && 'relative', className]}
  style={`--hive-ratio: ${widthUnits.toFixed(3)} / ${heightUnits.toFixed(3)}`}
  data-hive={intro ? 'intro' : ''}
  aria-hidden="true"
>
  {
    cells.map((c, i) => {
      const x = c.col * 0.75 * W
      const y = ((c.row + (c.col % 2 ? 0.5 : 0)) * H * 100) / ((heightUnits * 100) / widthUnits)
      return (
        <div
          class:list={['cell', `cell--${c.kind === 'shot' || c.kind === 'outline' ? c.kind : 'fill'}`]}
          style={`--x:${x.toFixed(3)}%;--y:${y.toFixed(3)}%;--w:${W.toFixed(3)}%`}
          data-depth={c.depth ?? 0.4}
          data-i={i}
        >
          <div class="cell__float" data-pop>
            <div class:list={['cell__face', fill[c.kind]]}>
              {c.kind === 'shot' && c.img && <img src={c.img} alt="" width="480" height="300" decoding="async" />}
            </div>
          </div>
        </div>
      )
    })
  }
</div>
