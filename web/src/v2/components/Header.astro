---
// Sewagi header: sticky, blurred page band, hive-house mark, 3px teal underline for the current item.
import ThemeToggle from '../../components/ThemeToggle.astro'

interface Props {
  /** section id whose link marks the current page (case pages) */
  current?: string
}
const { current } = Astro.props

const links = [
  { label: 'Projects', href: '/v2#projects', id: 'projects' },
  { label: 'Work', href: '/v2#work', id: 'work' },
  { label: 'Writing', href: '/v2#writing', id: 'writing' },
  { label: 'Contact', href: '/v2#connect', id: 'connect' },
]
---

<header class="sticky top-0 z-40 border-b border-line-soft bg-page/85 backdrop-blur-md">
  <div class="container-wide flex h-[68px] items-center justify-between gap-6">
    <a href="/v2" class="group inline-flex items-center gap-2.5" aria-label="Brendatama Akbar, home">
      <svg class="h-8 w-8 shrink-0 text-teal transition-transform duration-500 group-hover:-rotate-12" viewBox="0 0 32 32" fill="none" aria-hidden="true">
        <path d="M16 2.8 28 9.4v12.2a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3V9.4L16 2.8z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
        <path d="M12 24.6v-6.2h8v6.2" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
      </svg>
      <span class="type-h4 text-heading">Brendatama</span>
    </a>

    <div class="flex h-full items-center gap-6">
      <nav class="hidden h-full items-center gap-7 md:flex" aria-label="Main">
        {
          links.map((l) => (
            <a class="nav-link" href={l.href} data-spy={l.id} aria-current={l.id === current ? 'page' : undefined}>
              {l.label}
            </a>
          ))
        }
      </nav>
      <ThemeToggle />
      <button
        type="button"
        class="btn-pill h-9 px-4 md:hidden"
        aria-expanded="false"
        aria-controls="menu"
        data-menu-open
      >
        Menu
      </button>
    </div>
  </div>
</header>

<div id="menu" class="fixed inset-0 z-50 overflow-hidden bg-navy text-white" role="dialog" aria-modal="true" aria-label="Menu" hidden>
  <div class="hex pointer-events-none absolute -right-16 -bottom-10 aspect-[1.15] w-72 bg-teal/25" aria-hidden="true"></div>
  <div class="hex pointer-events-none absolute right-24 bottom-56 aspect-[1.15] w-16 bg-peach" aria-hidden="true"></div>
  <div class="container-wide flex h-[68px] items-center justify-end">
    <button type="button" class="btn-pill h-9 border-white/30 bg-transparent px-4 text-white" data-menu-close>Close</button>
  </div>
  <nav class="container-wide mt-10" aria-label="Main">
    <p class="mb-6 type-subtitle text-[11px] text-white/60">Menu</p>
    <ul class="grid gap-2">
      {
        links.map((l, i) => (
          <li class="overflow-hidden">
            <a href={l.href} class="block py-1 text-[40px] leading-tight font-bold" data-menu-link>
              <span class="text-peach">{String(i + 1).padStart(2, '0')}.</span> {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>
