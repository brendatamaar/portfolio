---

import Logo from './Logo.astro'
import type { Current } from '../layouts/V2.astro'

interface Props {
  current: Current
}
const { current } = Astro.props
const links = [
  { label: 'Home', href: '/', key: 'home' },
  { label: 'Writing', href: '/blog', key: 'blog' },
]
---

<header class="nav">
  <div class="nav__bar">
    <a class="nav__brand" href="/" aria-current={current === 'home' ? 'page' : undefined}>
      <Logo />
    </a>
    <nav class="nav__links" aria-label="Main">
      <ul>
        {
          links.map((l) => (
            <li>
              <a
                class="nav-link"
                href={l.href}
                aria-current={current === l.key ? 'page' : undefined}

              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
