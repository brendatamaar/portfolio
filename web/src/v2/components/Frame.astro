---
// Fixed four-corner frame: name top-left, nav top-right; a menu overlay on phones.
import { site } from '../data/content'

interface Props {
  /** section id whose link marks the current page (case pages) */
  current?: string
}
const { current } = Astro.props

const links = [
  { label: 'Work', href: '/v2#grid', id: 'grid' },
  { label: 'Off grid', href: '/v2#off-grid', id: 'off-grid' },
  { label: 'Notes', href: '/v2#notes', id: 'notes' },
  { label: 'Contact', href: '/v2#ground', id: 'ground' },
]
---

<header class="frame">
  <a href="/v2" class="frame__name wire-link" aria-label={`${site.name}, home`}>
    <b>{site.short}</b>
  </a>
  <nav class="frame__nav" aria-label="Main">
    {
      links.map((l) => (
        <a class="wire-link" href={l.href} data-spy={l.id} aria-current={l.id === current ? 'page' : undefined}>
          {l.label}
        </a>
      ))
    }
  </nav>
  <button class="frame__menu wire-link" type="button" aria-expanded="false" aria-controls="menu" data-menu-open>
    Menu
  </button>
</header>

<div class="menu" id="menu" role="dialog" aria-modal="true" aria-label="Menu" hidden>
  <button class="menu__close wire-link" type="button" data-menu-close>Close</button>
  <nav aria-label="Main">
    <ul class="menu__list display">
      {
        links.map((l) => (
          <li>
            <a href={l.href} data-menu-link>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <p class="mono">Jakarta, {site.volts} V / {site.hertz} Hz</p>
</div>
