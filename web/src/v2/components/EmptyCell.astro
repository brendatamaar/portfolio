---
// 404: the honeycomb with one cell missing.
import Hive from './Hive.astro'
import Icon from '../../components/Icon.astro'
import Roll from './Roll.astro'

const path = Astro.url.pathname
---

<section class="relative" aria-labelledby="missing-title">
  <div class="container-wide grid items-center gap-12 py-20 md:py-28 lg:grid-cols-12">
    <div class="lg:col-span-6">
      <p class="mb-3 flex items-center gap-2 type-subtitle text-[11px] text-muted">
        <span class="hex inline-block aspect-[1.15] w-2.5 bg-teal" aria-hidden="true"></span>
        Error 404
      </p>
      <h1 id="missing-title" class="type-display text-heading" data-settle>
        <span class="ink-peach">This cell is empty.</span>
        <span>Nothing lives at this address.</span>
      </h1>
      <p class="mt-6 max-w-lg type-lead text-body">
        <code class="rounded-sm bg-sunken px-1.5 py-0.5 text-[0.9em] break-all text-heading">{path}</code> isn’t part of the
        site. The projects, work and writing are all one click away.
      </p>
      <a href="/v2" class="btn btn-primary mt-9" data-reveal="up" data-intro data-delay="0.45">
        <Icon name="arrow-left" class="h-4 w-4" strokeWidth={2} />
        <Roll text="Back to home" />
      </a>
    </div>
    <div class="lg:col-span-6">
      <Hive
        intro
        class="mx-auto w-[80%] max-w-[480px]"
        cells={[
          { col: 0, row: 0, kind: 'teal', depth: 0.5 },
          { col: 0, row: 1, kind: 'butter', depth: 0.8 },
          { col: 1, row: 0, kind: 'apricot', depth: 0.7 },
          { col: 1, row: 1, kind: 'outline', depth: 0.2 },
          { col: 2, row: 0, kind: 'lilac', depth: 0.6 },
          { col: 2, row: 1, kind: 'peach', depth: 0.9 },
          { col: 1, row: 2, kind: 'teal', depth: 0.4 },
        ]}
      />
    </div>
  </div>
</section>
