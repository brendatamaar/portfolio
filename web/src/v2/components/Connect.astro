---
// 04. Connect: the Sewagi navy band, a floating honeycomb, one clear action.
import Icon from '../../components/Icon.astro'
import Hive from './Hive.astro'
import Roll from './Roll.astro'
import { copy, site } from '../data/content'

interface Props {
  email?: string
  links: { label: string; href: string }[]
  num?: string
}
const { email = 'brendatamaa@gmail.com', links, num = '04' } = Astro.props
---

<section id="connect" data-section="connect" class="relative overflow-hidden bg-navy text-white" aria-labelledby="connect-title">
  <div class="dots pointer-events-none absolute top-[14%] right-[30%] hidden h-36 w-56 text-white/15 lg:block" aria-hidden="true"></div>
  <Hive
    class="pointer-events-none absolute top-1/2 -right-16 hidden w-[44%] max-w-[560px] -translate-y-1/2 lg:block"
    cells={[
      { col: 0, row: 1, kind: 'peach', depth: 0.7 },
      { col: 1, row: 0, kind: 'teal', depth: 0.3 },
      { col: 1, row: 1, kind: 'outline', depth: 0.5 },
      { col: 2, row: 0, kind: 'butter', depth: 0.6 },
      { col: 2, row: 1, kind: 'teal', depth: 0.25 },
      { col: 3, row: 0, kind: 'lilac', depth: 0.8 },
    ]}
  />

  <div class="container-wide relative py-20 md:py-32">
    <div class="max-w-2xl">
      <p class="mb-3 flex items-center gap-2 type-subtitle text-[11px] text-white/60">
        <span class="hex inline-block aspect-[1.15] w-2.5 bg-teal" aria-hidden="true"></span>
        {copy.connect.eyebrow}
      </p>
      <h2 id="connect-title" class="type-section text-white" data-split="lines">
        {num && <span class="ink-peach">{num}.</span>}
        {copy.connect.title}
      </h2>
      <p class="mt-6 type-h3 text-white" data-split="lines" data-delay="0.1">
        <span class="ink-peach">{copy.connect.hook}</span>
        {copy.connect.line}
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-3" data-reveal="up" data-delay="0.2">
        <a href={`mailto:${email}`} class="btn btn-primary">
          <Icon name="mail" class="h-4 w-4" strokeWidth={2} />
          <Roll text="Send an email" />
        </a>
        {
          links.map((s) => (
            <a href={s.href} target="_blank" rel="noopener noreferrer" class="btn border-white/30 text-white hover:border-teal hover:bg-teal">
              <Roll text={s.label} />
              <Icon name="external" class="nudge-up nudge h-4 w-4" strokeWidth={2} />
            </a>
          ))
        }
      </div>
      <p class="mt-8 text-sm text-white/60">
        Or write to <a class="inline-block py-0.5 font-semibold text-white underline decoration-teal decoration-2 underline-offset-4 transition-[color,text-decoration-thickness] hover:text-teal hover:decoration-4" href={`mailto:${email}`}>{email}</a>. The
        <a class="inline-block py-0.5 font-semibold text-white underline decoration-teal decoration-2 underline-offset-4 transition-[color,text-decoration-thickness] hover:text-teal hover:decoration-4" href={site.resume} download data-astro-reload>resume</a> has the long version.
      </p>
    </div>
  </div>
</section>
