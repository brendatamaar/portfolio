---
// Sewagi card for a project: media on top (screenshot, or a pastel cover with its name),
// title, one line, stack tags. Lifts on hover; links to the case page.
import Icon from '../../components/Icon.astro'
import { srcset, type Project } from '../data/content'

interface Props {
  project: Project
  /** large card spanning two columns */
  wide?: boolean
  /** text-only card for lists inside a work row */
  compact?: boolean
  index?: number
}
const { project: p, wide = false, compact = false, index = 0 } = Astro.props
const covers = ['bg-teal/15', 'bg-apricot/45', 'bg-lilac/35', 'bg-butter/45']
---

<a
  href={`/v2/work/${p.slug}`}
  class="card lift group relative flex h-full flex-col overflow-hidden"
  data-title={p.title}
  data-reveal="up"
  data-delay={String((index % 3) * 0.08)}
>
  {!compact && (
  <div class="lift__media relative overflow-hidden border-b border-line-soft bg-sunken">
    {
      p.cover ? (
        <img
          src={p.cover}
          srcset={srcset(p.cover)}
          sizes={wide ? '(min-width: 1024px) 66vw, 100vw' : '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw'}
          alt={`Screenshot of ${p.title}`}
          width="1600"
          height="1000"
          loading="lazy"
          decoding="async"
          class:list={['w-full object-cover object-top', wide ? 'aspect-[2/1]' : 'aspect-[16/10]']}
        />
      ) : (
        <div class:list={['lift__cover relative flex w-full items-center justify-center overflow-hidden', covers[index % covers.length], wide ? 'aspect-[2/1]' : 'aspect-[16/10]']}>
          <span class="hex absolute -right-8 -bottom-10 aspect-[1.15] w-36 bg-teal/25" aria-hidden="true" />
          <span class="hex absolute top-5 left-6 aspect-[1.15] w-9 bg-peach/70" aria-hidden="true" />
          <span class="dots absolute top-6 right-8 h-14 w-20 text-teal/30" aria-hidden="true" />
          <span class="hex absolute top-1/2 left-1/2 aspect-[1.15] w-20 -translate-x-1/2 -translate-y-1/2 bg-surface/80 shadow-card" aria-hidden="true" />
          <span class="hex absolute top-[calc(50%-38px)] left-[calc(50%+32px)] aspect-[1.15] w-12 bg-butter/80" aria-hidden="true" />
        </div>
      )
    }
  </div>
  )}
  <div class="lift__hex hex pointer-events-none absolute -top-5 -right-5 aspect-[1.15] w-14 bg-apricot/70" aria-hidden="true"></div>

  <div class:list={['flex flex-1 flex-col', compact ? 'p-5' : 'p-6']}>
    <h3 class="lift__title type-h4 text-heading">{p.title}</h3>
    <p class:list={['mt-2 text-body', compact ? 'text-[13px]' : 'text-sm', !wide && 'line-clamp-3']}>{p.description}</p>
    <div class="mt-auto pt-5">
      {
        p.techStack.length > 0 && (
          <div class="mb-4 flex flex-wrap gap-1.5">
            {p.techStack.slice(0, wide ? 5 : 3).map((t, i) => (
              <span class:list={['tag', i > 0 && 'tag-outline']}>{t}</span>
            ))}
          </div>
        )
      }
      <hr class="hairline mb-3" />
      <span class="link-arrow text-[13px]">
        View case <Icon name="arrow-right" class="nudge h-4 w-5" />
      </span>
    </div>
  </div>
</a>
