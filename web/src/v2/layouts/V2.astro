---
import { ClientRouter } from 'astro:transitions'
import poppins400 from '@fontsource/poppins/files/poppins-latin-400-normal.woff2?url'
import poppins500 from '@fontsource/poppins/files/poppins-latin-500-normal.woff2?url'
import poppins600 from '@fontsource/poppins/files/poppins-latin-600-normal.woff2?url'
import poppins700 from '@fontsource/poppins/files/poppins-latin-700-normal.woff2?url'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { site } from '../data/content'
import '../../globals.css'
import '../v2.css'

interface Props {
  title?: string
  description?: string
  /** root-relative OG image (1200x630) */
  image?: string
  /** nav section this page belongs to (case pages) */
  section?: string
  /** warm gradient (home) or cool gradient behind the top of the page */
  banner?: 'warm' | 'cool'
  /** extra structured data for this page (case studies) */
  jsonLd?: Record<string, unknown>
}

const { title, description = site.description, image = '/v2/og.png', section, banner = 'warm', jsonLd } = Astro.props
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.role}, Jakarta`
// Astro.url reflects the internal host behind the reverse proxy: build from `site` instead
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href
const ogImage = new URL(image, Astro.site ?? site.url).href
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  worksFor: { '@type': 'Organization', name: 'PLN Icon Plus' },
  address: { '@type': 'PostalAddress', addressLocality: 'Jakarta', addressCountry: 'ID' },
  url: site.url,
  sameAs: ['https://github.com/brendatamaar', 'https://www.linkedin.com/in/brendatamaar/'],
}

// Latin subset only, as in components/BaseHead.astro
const LATIN =
  'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD'
const fontCss = [
  ['400', poppins400],
  ['500', poppins500],
  ['600', poppins600],
  ['700', poppins700],
]
  .map(
    ([w, url]) =>
      `@font-face{font-family:'Poppins';font-style:normal;font-display:swap;font-weight:${w};src:url(${url}) format('woff2');unicode-range:${LATIN}}`,
  )
  .join('')
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/* Preview beside the live site: keep it out of search until it replaces the homepage */}
    <meta name="robots" content="noindex, follow" />
    <meta name="theme-color" content="#013240" />
    <link rel="icon" type="image/svg+xml" href="/images/favicon/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/images/favicon/favicon-96x96.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/favicon/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(person)} />
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <link rel="preload" href={poppins400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={poppins700} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontCss}></style>

    {/* Before first paint: theme (same rule as the classic site), plus engine flags */}
    <script is:inline>
      ;(function () {
        function apply(doc) {
          var s = null
          try {
            s = localStorage.getItem('theme')
          } catch (e) {}
          var d = window.matchMedia('(prefers-color-scheme: dark)').matches
          doc.documentElement.classList.toggle('dark', s === 'dark' || (s === null && d))
        }
        apply(document)
        document.addEventListener('astro:before-swap', function (e) {
          apply(e.newDocument)
        })
        document.documentElement.classList.add('js')
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion')
      })()
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body class="relative flex min-h-screen flex-col">
    <div
      class:list={['pointer-events-none absolute inset-x-0 top-0 h-[640px]', banner === 'warm' ? 'bg-hero' : 'bg-hero-alt']}
      aria-hidden="true"
    >
    </div>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-0 focus:left-0 focus:z-[9999] focus:flex focus:h-[68px] focus:items-center focus:bg-teal focus:px-6 focus:type-button focus:text-white"
    >
      Skip to main content
    </a>
    <div id="curtain" transition:persist="curtain" aria-hidden="true">
      <div class="curtain__panel"></div>
      <div class="curtain__label">
        <span class="hex inline-block aspect-[1.15] w-6 bg-teal"></span>
        <p class="type-h3" data-curtain-title></p>
      </div>
    </div>

    <Header current={section} />

    <main id="main" tabindex="-1" class="relative flex-1">
      <slot />
    </main>

    <Footer />

    <script>
      import { start } from '../engine/astro'
      import { setupMotion } from '../motion/setup'
      start(setupMotion)
    </script>
  </body>
</html>
