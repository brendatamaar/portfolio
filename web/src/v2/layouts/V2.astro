---
import { ClientRouter } from 'astro:transitions'
import { site } from '../data/content'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import '../styles/tokens.css'
import '../styles/engine.css'
import '../styles/shared.css'

export type Current = 'home' | 'work' | 'blog' | 'none'

interface Props {
  title?: string
  description?: string
  /** root-relative OG image (1200x630) */
  image?: string
  current?: Current
  /** extra JSON-LD for this page */
  schema?: Record<string, unknown>
}

const {
  title,
  description = site.description,
  image = '/v2/og.png',
  current = 'none',
  schema,
} = Astro.props
const fullTitle = title
  ? `${title} | ${site.name}`
  : `${site.name}, ${site.role} based in Jakarta`
// Astro.url reflects the internal host behind the reverse proxy: build from `site` instead
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href
const ogImage = new URL(image, Astro.site ?? site.url).href
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.fullName,
  alternateName: site.name,
  jobTitle: site.role,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Jakarta',
    addressCountry: 'ID',
  },
  worksFor: {
    '@type': 'Organization',
    name: 'PLN Icon Plus',
    url: 'https://plniconplus.co.id/',
  },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'CEP CCIT University of Indonesia',
  },
  url: site.url,
  sameAs: site.socials.map((s) => s.href),
}
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/* Preview beside the live site: keep it out of search until it replaces the homepage */}
    <meta name="robots" content="noindex, follow" />
    <meta name="theme-color" content="#0e1a2b" />
    <meta name="author" content={site.fullName} />
    <link rel="icon" type="image/svg+xml" href="/images/favicon/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/images/favicon/favicon-96x96.png" />
    <link rel="apple-touch-icon" href="/images/favicon/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(person)} />
    {schema && <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />}
    <link rel="preload" href="/v2/fonts/archivo-100_900-normal.woff2" as="font" type="font/woff2" crossorigin />
    <!-- Before first paint: flag JS + motion so hidden-until-revealed states never flash. -->
    <script is:inline>
      document.documentElement.classList.add('js')
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches)
        document.documentElement.classList.add('motion')
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div id="curtain" transition:persist="curtain" aria-hidden="true">
      <div class="curtain__panel">
        <span class="curtain__band curtain__band--orange"></span>
        <span class="curtain__band curtain__band--lavender"></span>
        <span class="curtain__band curtain__band--lime"></span>
        <span class="curtain__band curtain__band--navy"></span>
      </div>
      <div class="curtain__req">
        <span class="mono">GET</span>
        <span class="mono curtain__path" data-req-path>/</span>
        <span class="mono curtain__status" data-req-status></span>
        <span class="curtain__bar"><span></span></span>
      </div>
    </div>
    <Header current={current} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import { start } from '../engine/astro'
      import { setupMotion } from '../motion/setup'
      start(setupMotion)
    </script>
  </body>
</html>
