---
import Page from './Page.astro'
import Rows from './Rows.astro'
import '../styles/post.css'
import { blog, blogPath, copy, postPath, site, type Lang } from '../data/content'
import type { PostPage } from '../data/post'
import { fullDate } from '../data/posts'
import { formatCitation } from '@portfolio/shared/markdown/citation'

interface Props {
  lang: Lang
  page: PostPage
}
const { lang, page } = Astro.props
const t = blog[lang]
const post = page.post
const published = post.publishedAt ?? post.createdAt
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.description,
  inLanguage: lang,
  datePublished: published,
  author: { '@type': 'Person', name: site.name, url: site.url },
  keywords: post.tags.map((tag) => tag.name).join(', '),
}
// JSON for the popup script; "<" is escaped so post content can never close the tag
const island = JSON.stringify({ glossary: page.popupGlossary, bibliography: page.popupBibliography }).replace(/</g, '\\u003c')
const hasContents = page.toc.length > 0 || page.glossary.length > 0 || page.bibliography.length > 0

// Collapsible blocks around the article: contents, glossary, bibliography
const fold = 'mt-7 border-t border-dotted border-leader pt-2.5 text-[14px] text-body'
const summary = 'cursor-pointer py-1 text-quiet transition-colors hover:text-ink'
const num = 'inline-block text-quiet tabular-nums'
// A side-contents entry; scripts/post.ts marks the section in view with data-active
const tocLink =
  '-ml-px block border-l border-transparent py-0.75 pl-3 text-quiet transition-colors hover:text-ink data-active:border-ink data-active:text-ink'
---

<Page
  lang={lang}
  title={post.title}
  description={post.description}
  path={postPath(lang, post.slug)}
  ogType="article"
  schema={schema}
  alternates={{ en: postPath('en', post.slug), id: postPath('id', post.slug) }}
>
  <article>
    <header>
      <a class="inline-block py-1.5 text-[14px] text-quiet transition-colors hover:text-ink" href={blogPath(lang)}>{t.back}</a>
      <h1 class="mt-3 mb-2.5 text-[28px] leading-[1.3] font-medium tracking-[-0.02em] text-balance text-ink">{post.title}</h1>
      {post.description && <p class="mb-3.5 text-[16px] leading-[1.7] text-body">{post.description}</p>}
      <p class="flex flex-wrap gap-x-2 gap-y-1 text-[14px] text-quiet">
        <time datetime={published.slice(0, 10)}>{fullDate(published, lang)}</time>
        <span aria-hidden="true">·</span>
        <span>{t.minRead(page.mins)}</span>
        {post.tags.length > 0 && (
          <>
            <span aria-hidden="true">·</span>
            <span>{post.tags.map((tag) => tag.name).join(', ')}</span>
          </>
        )}
        <span aria-hidden="true">·</span>
        <button type="button" class="cursor-pointer border-b border-dotted border-quiet bg-transparent p-0 text-quiet transition-colors hover:text-ink" data-copy-link data-label={t.copyLink} data-copied={t.copied}>{t.copyLink}</button>
      </p>
    </header>

    {hasContents && (
      <details class:list={[fold, 'wide:hidden']}>
        <summary class={summary}>{t.contents}</summary>
        <ul class="mt-2">
          {page.toc.map((item) => (
            <li style={`padding-left: ${(item.level - page.minLevel) * 14}px`}>
              <a class="block py-0.5 transition-colors hover:text-ink" href={`#${item.id}`}>
                <span class:list={[num, 'mr-2 min-w-[2.2ch]']}>{item.num}</span>
                {item.text}
              </a>
            </li>
          ))}
          {page.glossary.length > 0 && <li><a class="block py-0.5 transition-colors hover:text-ink" href="#glossary-section">{t.glossary}</a></li>}
          {page.bibliography.length > 0 && <li><a class="block py-0.5 transition-colors hover:text-ink" href="#bibliography-section">{t.bibliography}</a></li>}
        </ul>
      </details>
    )}

    <div class="group/body relative" data-post-body>
      {hasContents && (
        <aside class="absolute top-0 bottom-0 left-[calc(100%+44px)] hidden w-47.5 wide:block" aria-label={t.contents}>
          <nav class="sticky top-6 max-h-[calc(100vh-48px)] overflow-y-auto text-[13px] leading-[1.5]">
            <p class="mb-2 text-quiet">{t.contents}</p>
            <ul class="border-l border-leader">
              {page.toc.map((item) => (
                <li style={`padding-left: ${(item.level - page.minLevel) * 12}px`}>
                  <a class={tocLink} href={`#${item.id}`} data-toc-link={item.id}>
                    <span class:list={[num, 'mr-1.5']}>{item.num}</span>
                    {item.text}
                  </a>
                </li>
              ))}
              {page.glossary.length > 0 && <li><a class={tocLink} href="#glossary-section" data-toc-link="glossary-section">{t.glossary}</a></li>}
              {page.bibliography.length > 0 && <li><a class={tocLink} href="#bibliography-section" data-toc-link="bibliography-section">{t.bibliography}</a></li>}
            </ul>
          </nav>
        </aside>
      )}
      <div class="prose" set:html={page.html} />
      {page.sidenotes.length > 0 && (
        <aside
          class="absolute top-0 right-[calc(100%+44px)] bottom-0 hidden w-52.5 text-[13px] leading-[1.55] text-quiet wide:block"
          aria-label={copy[lang].notes}
          data-sidenotes
        >
          {page.sidenotes.map((note) => (
            <div
              class="invisible absolute inset-x-0 border-r border-leader pr-3 text-right group-data-side/body:visible data-lit:animate-lit motion-reduce:data-lit:animate-none motion-reduce:data-lit:text-ink"
              data-sidenote={note.id}
            >
              <sup>[{note.id}]</sup> <span set:html={note.html} />
            </div>
          ))}
        </aside>
      )}
    </div>

    <script is:inline type="application/json" id="post-data" set:html={island} />

    {page.glossary.length > 0 && (
      <details class={fold} id="glossary-section">
        <summary class={summary}>{t.glossary} <span class="ml-1 text-quiet">{page.glossary.length}</span></summary>
        <dl class="m-0 mt-2.5">
          {page.glossary.map((entry) => (
            <div class="cursor-pointer py-1" data-gloss-entry={entry.key}>
              <dt class="font-medium text-ink"><span class:list={[num, 'mr-2 min-w-[2.2ch]']}>{entry.num}</span>{entry.term}</dt>
              <dd class="m-0 mb-2.5 text-body" set:html={entry.definition} />
            </div>
          ))}
        </dl>
      </details>
    )}

    {page.bibliography.length > 0 && (
      <details class={fold} id="bibliography-section">
        <summary class={summary}>{t.bibliography} <span class="ml-1 text-quiet">{page.bibliography.length}</span></summary>
        <ol class="m-0 mt-2.5 list-none p-0">
          {page.bibliography.map((entry) => (
            <li class="flex cursor-pointer py-1" data-cite-entry={entry.key}>
              <span class:list={[num, 'mr-2 min-w-[2.2ch]']}>{entry.num}</span>
              <span set:html={formatCitation(entry.text)} />
            </li>
          ))}
        </ol>
      </details>
    )}
  </article>

  {page.next && (
    <nav class="mt-14" aria-label={t.next}>
      <h2 class="mb-1.5 text-[14px] text-quiet">{t.next}</h2>
      <Rows rows={[{ k: page.next.title, v: t.read, href: postPath(lang, page.next.slug) }]} />
    </nav>
  )}
</Page>

<script>
  import { initPost } from '../scripts/post'
  initPost()
</script>
