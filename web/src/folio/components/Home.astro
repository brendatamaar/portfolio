---
import Folio from '../layouts/Folio.astro'
import Header from './Header.astro'
import Hero from './Hero.astro'
import Rows from './Rows.astro'
import Preview from './Preview.astro'
import Garland from './Garland.astro'
import Footer from './Footer.astro'
import { copy, homePath, postPath, type Lang } from '../data/content'
import { loadPosts, monthYear } from '../data/posts'
import { loadProjects, previewMap } from '../data/projects'

const { lang } = Astro.props as { lang: Lang }
const t = copy[lang]
const [posts, projects] = await Promise.all([loadPosts(lang), loadProjects(lang)])
---

<Folio lang={lang} alternates={homePath}>
  <div class="wrap">
    <Header lang={lang} />
    <main id="main" tabindex="-1">
      <Hero lang={lang} />

      <section aria-labelledby="h-proj">
        <h2 class="label" id="h-proj">{t.projects}</h2>
        {
          projects.length > 0 ? (
            <Rows
              id="projects"
              preview
              rows={projects.map((p) => ({ k: p.name, v: p.description, href: p.href, external: true }))}
            />
          ) : (
            <p class="empty">{t.noProjects}</p>
          )
        }
      </section>

      <section aria-labelledby="h-blog">
        <h2 class="label" id="h-blog">{t.blog}</h2>
        {
          posts.length > 0 ? (
            <Rows
              id="blog"
              rows={posts.map((p) => ({ k: p.title, v: monthYear(p.date, lang), href: postPath(lang, p.slug) }))}
            />
          ) : (
            <p class="empty">{t.noPosts}</p>
          )
        }
      </section>
    </main>
  </div>
  <Garland />
  <Footer lang={lang} />
  <Preview previews={previewMap(projects)} />
</Folio>
