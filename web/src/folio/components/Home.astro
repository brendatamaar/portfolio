---
import Folio from '../layouts/Folio.astro'
import Header from './Header.astro'
import Hero from './Hero.astro'
import Rows from './Rows.astro'
import Preview from './Preview.astro'
import KoiPond from './KoiPond.astro'
import Footer from './Footer.astro'
import { copy, homePath, postPath, type Lang } from '../data/content'
import { loadPosts, monthYear } from '../data/posts'
import { loadProjects, previewMap, cardSrc } from '../data/projects'

const { lang } = Astro.props as { lang: Lang }
const t = copy[lang]
const [posts, projects] = await Promise.all([loadPosts(lang), loadProjects(lang)])
---

<Folio lang={lang} alternates={homePath}>
  <div class="mx-auto max-w-176 px-safe pt-8">
    <Header lang={lang} />
    <main id="main" tabindex="-1" class="flex flex-col gap-16 pt-10">
      <Hero lang={lang} />

      <section aria-labelledby="h-proj">
        <h2 class="mb-1.5 text-[14px] text-quiet" id="h-proj">{t.projects}</h2>
        {
          projects.length > 0 ? (
            <Rows
              id="projects"
              preview
              rows={projects.map((p) => ({
                k: p.name,
                v: p.description,
                href: p.href,
                external: true,
                img: p.img ? cardSrc(p.img) : undefined,
              }))}
            />
          ) : (
            <p class="text-[14px] text-quiet">{t.noProjects}</p>
          )
        }
      </section>

      <section aria-labelledby="h-blog">
        <h2 class="mb-1.5 text-[14px] text-quiet" id="h-blog">{t.blog}</h2>
        {
          posts.length > 0 ? (
            <Rows
              id="blog"
              rows={posts.map((p) => ({ k: p.title, v: monthYear(p.date, lang), href: postPath(lang, p.slug) }))}
            />
          ) : (
            <p class="text-[14px] text-quiet">{t.noPosts}</p>
          )
        }
      </section>
    </main>
  </div>
  <KoiPond lang={lang} />
  <Footer lang={lang} />
  <Preview previews={previewMap(projects)} />
</Folio>
