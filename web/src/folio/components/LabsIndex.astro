---
import Page from './Page.astro'
import Rows from './Rows.astro'
import { labsPath, labsCopy, type Lang } from '../data/content'
import { api } from '../../lib/api'
import type { LabItem } from '../../lib/types'

const { lang } = Astro.props as { lang: Lang }
const t = labsCopy[lang]

let labs: LabItem[] = []
try {
  labs = await api.getLabs()
} catch {
  // API down: show the empty state rather than a 500
}

const note = (l: LabItem) =>
  l.status === 'wip' ? t.wip : l.status === 'archived' ? t.archived : ''
---

<Page
  lang={lang}
  title={t.title}
  description={t.description}
  path={labsPath(lang)}
  alternates={{ en: labsPath('en'), id: labsPath('id') }}
>
  <section aria-labelledby="h-labs">
    <h1 class="mb-1.5 text-[14px] text-quiet" id="h-labs">{t.title}</h1>
    <p class="mb-2.5 text-[14px] leading-[1.7] text-quiet">{t.lede}</p>
    {
      labs.length > 0 ? (
        <Rows
          rows={labs.map((l) => ({
            k: l.title,
            v: [l.summary, note(l) && `(${note(l)})`].filter(Boolean).join(' '),
            href: l.resolvedDemoUrl,
            external: true,
          }))}
        />
      ) : (
        <p class="text-[14px] text-quiet">{t.empty}</p>
      )
    }
  </section>
</Page>
