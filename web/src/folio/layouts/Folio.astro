---
import '../styles/folio.css'
// The two weights the page is set in: fetched alongside the stylesheet, not after it
import font400 from '@fontsource/plus-jakarta-sans/files/plus-jakarta-sans-latin-400-normal.woff2?url'
import font500 from '@fontsource/plus-jakarta-sans/files/plus-jakarta-sans-latin-500-normal.woff2?url'
import { copy, homePath, site, socials, type Lang } from '../data/content'

interface Props {
  lang: Lang
  /** The same page in each language, as root-relative paths: emits hreflang links. */
  alternates?: Partial<Record<Lang, string>>
  /** Page title (without the site name). Omit for the homepage title. */
  title?: string
  description?: string
  /** Root-relative canonical path. Defaults to the language's home. */
  path?: string
  ogType?: 'website' | 'article'
  /** Extra JSON-LD for this page. */
  schema?: Record<string, unknown>
  /** Optional above-the-fold LCP image to preload. */
  preloadImage?: { href: string; media?: string }
}

const { lang, alternates, title, description, path, ogType = 'website', schema, preloadImage } = Astro.props
const t = copy[lang]
const fullTitle = title ? `${title} | ${site.name}` : t.title
const desc = description ?? t.description
// Astro.url reflects the internal host behind the reverse proxy: build from the site URL instead
const base = Astro.site ?? site.url
const canonical = new URL(path ?? homePath[lang], base).href
const ogImage = new URL('/og.png', base).href
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: copy.en.role,
  url: site.url,
  email: site.email,
  worksFor: {
    '@type': 'Organization',
    name: 'Icon Plus',
    url: 'https://plniconplus.co.id/',
  },
  sameAs: [socials.github.href, socials.linkedin.href],
}
---

<!doctype html>
<html lang={lang} class="bg-page">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {alternates && Object.entries(alternates).map(([l, p]) => <link rel="alternate" hreflang={l} href={new URL(p, base).href} />)}
    {alternates?.en && <link rel="alternate" hreflang="x-default" href={new URL(alternates.en, base).href} />}
    <meta name="theme-color" content="#131313" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="author" content={site.name} />
    <link rel="preload" as="font" type="font/woff2" href={font400} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={font500} crossorigin />
    {preloadImage && <link rel="preload" as="image" href={preloadImage.href} media={preloadImage.media} fetchpriority="high" />}
    <link rel="icon" type="image/svg+xml" href="/images/favicon/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/images/favicon/favicon-96x96.png" />
    <link rel="apple-touch-icon" href="/images/favicon/apple-touch-icon.png" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'id' ? 'id_ID' : 'en_US'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(person)} />
    {schema && <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />}
    <!-- Before first paint: apply the saved theme so there is no flash. -->
    <script is:inline>
      try {
        var th = localStorage.getItem('ka-theme')
        if (th === 'light' || th === 'dark') document.documentElement.dataset.theme = th
      } catch (e) {}
    </script>
  </head>
  <body
    class="m-0 overflow-x-hidden bg-page font-sans text-[16px] leading-[1.75] font-normal text-ink antialiased transition-[background-color,color] duration-250 motion-reduce:transition-none"
  >
    <a class="absolute -top-25 left-4 z-40 bg-page px-2.5 py-1.5 text-[14px] text-ink focus:top-2" href="#main">{t.skip}</a>
    <slot />
  </body>
</html>
