---
import { formatCitation } from '@portfolio/shared/markdown/citation'
import type { BibliographyEntry } from '../lib/types'
import Icon from './Icon.astro'

interface Props {
  bibliography: BibliographyEntry[]
}

const { bibliography } = Astro.props

if (!bibliography.length) return
---

<section id="bibliography-section" class="panel overflow-hidden" aria-label="Bibliography">
  <button
    id="bibliography-toggle"
    type="button"
    class="flex w-full items-center justify-between px-6 py-5 text-left transition-colors hover:bg-sunken sm:px-9"
    aria-expanded="false"
    aria-controls="bibliography-body"
  >
    <span class="flex items-center gap-3">
      <span class="type-subtitle text-heading">Bibliography</span>
      <span class="tag">{bibliography.length}</span>
    </span>
    <span id="bibliography-chevron" class="text-teal transition-transform">
      <Icon name="chevron-down" class="h-5 w-5" />
    </span>
  </button>

  <div id="bibliography-body" class="overflow-hidden" style="max-height: 0">
    <ol class="m-0 list-none border-t border-line-soft px-6 sm:px-9">
      {bibliography.map((entry) => (
        <li
          class="bib-section-entry -mx-3 flex cursor-pointer items-baseline gap-3 border-b border-line-soft px-3 py-4 transition-colors last:border-0 hover:bg-sunken"
          data-cite-key={entry.key}
        >
          <span class="tag shrink-0">{entry.num}</span>
          <span class="text-sm text-body" set:html={formatCitation(entry.text)} />
        </li>
      ))}
    </ol>
  </div>
</section>

<script>
  import { onPageLoad } from '../scripts/lifecycle'

  onPageLoad(() => {
    const toggle = document.getElementById('bibliography-toggle')
    const body = document.getElementById('bibliography-body')
    const chevron = document.getElementById('bibliography-chevron')
    if (!toggle || !body || !chevron) return

    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true'
      toggle.setAttribute('aria-expanded', String(!open))
      chevron.style.transform = open ? '' : 'rotate(180deg)'
      body.style.maxHeight = open ? '0' : `${body.scrollHeight}px`
    })

    document.querySelectorAll<HTMLElement>('.bib-section-entry').forEach((el) => {
      el.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a')) return
        const key = el.dataset.citeKey
        if (!key) return
        const ref = document.querySelector<HTMLElement>(`[data-cite-id="${key}"]`)
        if (!ref) return
        ref.scrollIntoView({ behavior: 'smooth', block: 'center' })
      })
    })
  })
</script>
