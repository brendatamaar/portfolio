---
import type { PostSummary } from '../lib/types'
import { formatDate } from '../lib/utils'
import Icon from './Icon.astro'

interface Props {
  post: PostSummary
  lang?: 'en' | 'id'
  index?: number
}

const { post, lang = 'en', index = 0 } = Astro.props
const date = new Date(post.publishedAt ?? post.createdAt)
const readLabel = lang === 'id' ? 'Baca tulisan' : 'Read article'

const PASTELS = ['bg-butter', 'bg-apricot', 'bg-lilac']
const pastel = PASTELS[index % PASTELS.length]
---

<a
  href={`${lang === 'id' ? '/id' : ''}/blog/${post.slug}`}
  class="card card-hover group flex h-full flex-col overflow-hidden"
>
  <div class="relative aspect-[16/9] overflow-hidden">
    {post.coverImageUrl ? (
      <img
        src={post.coverImageUrl}
        alt=""
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
      />
    ) : (
      <div class={`relative h-full w-full ${pastel}`} aria-hidden="true">
        <div class="hex absolute -top-6 right-8 h-28 w-28 bg-white/50"></div>
        <div class="hex absolute right-28 bottom-4 h-12 w-12 bg-white/70"></div>
        <p class="absolute bottom-4 left-4 line-clamp-2 max-w-[70%] text-lg leading-snug font-bold text-navy/80">
          {post.title}
        </p>
      </div>
    )}
    {post.tags[0] && (
      <span class="absolute top-0 left-0 bg-teal px-3 py-1.5 text-[12px] font-semibold text-white">
        #{post.tags[0].name}
      </span>
    )}
  </div>

  <div class="flex flex-1 flex-col p-4 sm:p-5">
    <p class="mb-2 flex items-center gap-1.5 type-subtitle text-[11px] text-muted">
      <Icon name="calendar" class="h-3.5 w-3.5 text-teal" />
      <time datetime={date.toISOString()}>{formatDate(date, lang)}</time>
    </p>
    <h3 class="type-h4 line-clamp-2 text-heading">{post.title}</h3>
    {post.description && <p class="mt-1 line-clamp-2 text-sm text-body">{post.description}</p>}

    <div class="mt-auto pt-4">
      <hr class="hairline mb-3" />
      <div class="flex items-center justify-between gap-3">
        <div class="flex min-w-0 flex-wrap gap-1.5 overflow-hidden">
          {post.tags.slice(1, 3).map((tag) => (
            <span class="tag tag-outline">{tag.name}</span>
          ))}
        </div>
        <span class="link-arrow shrink-0 text-[13px] group-hover:underline">
          {readLabel}
          <Icon name="arrow-right" class="h-4 w-5" />
        </span>
      </div>
    </div>
  </div>
</a>
