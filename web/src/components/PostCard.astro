---
import type { PostSummary } from '../lib/types'
import { formatDate } from '../lib/utils'
import Icon from './Icon.astro'

interface Props {
  post: PostSummary
  lang?: 'en' | 'id'
}

const { post, lang = 'en' } = Astro.props
const date = new Date(post.publishedAt ?? post.createdAt)
---

<a
  href={`${lang === 'id' ? '/id' : ''}/blog/${post.slug}`}
  class="card card-hover group block p-5"
>
  <div class="mb-3 flex items-start justify-between gap-4">
    <span class="flex items-center gap-1.5 type-subtitle text-[11px] text-muted">
      <Icon name="calendar" class="h-3.5 w-3.5 text-teal" />
      <time datetime={date.toISOString()}>{formatDate(date, lang)}</time>
    </span>
    <Icon
      name="external"
      class="h-4 w-4 shrink-0 text-teal transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
    />
  </div>
  <h3 class="mb-1 type-h4 text-heading group-hover:text-link">{post.title}</h3>
  {post.description && <p class="line-clamp-2 text-sm text-body">{post.description}</p>}
  {post.tags.length > 0 && (
    <div class="mt-4 flex flex-wrap gap-1.5">
      {post.tags.map((tag, i) => (
        <span class:list={['tag', i > 0 && 'tag-outline']}>#{tag.name}</span>
      ))}
    </div>
  )}
</a>
