---
import type { ResumeProjectItem } from '../lib/types'
import Icon from './Icon.astro'

interface Props {
  project: ResumeProjectItem
}

const { project } = Astro.props
const link = project.link

const Tag = link ? 'a' : 'div'
const linkProps = link ? { href: link.href, target: '_blank', rel: 'noopener noreferrer' } : {}
---

<!-- Slim row: title above description, full text (no truncation) -->
<Tag
  {...linkProps}
  class:list={[
    'group flex items-center gap-4 px-5 py-4 sm:px-6',
    link && 'transition-colors hover:bg-sunken',
  ]}
>
  <div class="min-w-0 flex-1">
    <h3 class:list={['font-semibold text-heading', link && 'group-hover:text-link']}>
      {project.title}
    </h3>
    <p class="mt-0.5 text-sm text-body">{project.description}</p>
  </div>

  {link && (
    <Icon name="external" class="h-4 w-4 shrink-0 text-muted transition group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-teal" />
  )}
</Tag>
