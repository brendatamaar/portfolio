---
import Base from '../layouts/Base.astro'
import PostCard from './PostCard.astro'
import type { PostSummary, PostTag } from '../lib/types'

interface Props {
  posts: PostSummary[]
  lang: 'en' | 'id'
  title: string
  heading: string
  description: string
  allLabel: string
  emptyLabel: string
}

const { posts, lang, title, heading, description, allLabel, emptyLabel } = Astro.props

// Unique tags across all posts, in first-seen order
const tags = [
  ...new Map(posts.flatMap((p) => p.tags).map((t): [string, PostTag] => [t.slug, t])).values(),
]
---

<Base {title} {description} ogType="website" {lang} current="writing" banner="cool">
  <div class="relative mb-12">
    <div class="hex pointer-events-none absolute -top-10 -right-10 hidden aspect-[1.15] w-36 bg-butter sm:block" aria-hidden="true"></div>
    <div class="hex pointer-events-none absolute top-24 right-36 hidden aspect-[1.15] w-10 bg-lilac sm:block" aria-hidden="true"></div>
    <div class="dots pointer-events-none absolute -top-6 right-52 hidden h-16 w-32 text-peach/50 md:block" aria-hidden="true"></div>
    <h1 class="relative mb-3 type-h1 text-heading">
      {heading}<span class="text-peach">.</span>
    </h1>
    <p class="relative max-w-md text-body">{description}</p>
  </div>

  {tags.length > 0 && (
    <div id="tag-bar" class="mb-6 flex flex-wrap gap-2" role="group" aria-label="Filter by tag">
      <button type="button" class="tag-btn btn-pill" data-tag="" aria-pressed="true">{allLabel}</button>
      {tags.map((tag) => (
        <button type="button" class="tag-btn btn-pill" data-tag={tag.slug} aria-pressed="false">#{tag.name}</button>
      ))}
    </div>
  )}

  <div id="post-list" class="flex flex-col gap-4">
    {posts.map((post) => (
      <div class="post-item" data-tags={post.tags.map((t) => t.slug).join(',')}>
        <PostCard post={post} {lang} />
      </div>
    ))}
    {posts.length === 0 && (
      <div class="panel flex items-center gap-5 p-6">
        <div class="hex aspect-[1.15] w-12 shrink-0 bg-butter" aria-hidden="true"></div>
        <p class="font-bold text-heading">{emptyLabel}</p>
      </div>
    )}
  </div>
</Base>

<script>
  import { onPageLoad } from '../scripts/lifecycle'

  onPageLoad(() => {
    const tagBar = document.getElementById('tag-bar')
    const postList = document.getElementById('post-list')
    if (!tagBar || !postList) return

    const items = Array.from(postList.querySelectorAll<HTMLElement>('.post-item'))
    const buttons = Array.from(tagBar.querySelectorAll<HTMLButtonElement>('.tag-btn'))
    let activeTag = ''

    tagBar.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.tag-btn')
      if (!btn) return
      const tag = btn.dataset.tag ?? ''
      activeTag = tag === activeTag ? '' : tag

      for (const item of items) {
        const show = !activeTag || (item.dataset.tags ?? '').split(',').includes(activeTag)
        item.hidden = !show
      }
      for (const b of buttons) {
        b.setAttribute('aria-pressed', String((b.dataset.tag ?? '') === activeTag))
      }
    })
  })
</script>
