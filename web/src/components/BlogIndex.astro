---
import Base from '../layouts/Base.astro'
import PostCard from './PostCard.astro'
import EmptyPosts from './EmptyPosts.astro'
import type { PostSummary, PostTag } from '../lib/types'

interface Props {
  posts: PostSummary[]
  lang: 'en' | 'id'
  title: string
  heading: string
  description: string
  allLabel: string
}

const { posts, lang, title, heading, description, allLabel } = Astro.props

// Unique tags across all posts, in first-seen order
const tags = [
  ...new Map(posts.flatMap((p) => p.tags).map((t): [string, PostTag] => [t.slug, t])).values(),
]
---

<Base {title} {description} ogType="website" {lang} current="writing" banner="cool">
  <!-- Banner -->
  <section class="container-page relative pt-14 pb-10 md:pt-20 md:pb-14">
    <div class="hex pointer-events-none absolute -top-6 right-6 hidden aspect-[1.15] w-48 bg-butter md:block" aria-hidden="true"></div>
    <div class="hex pointer-events-none absolute top-40 right-56 hidden aspect-[1.15] w-12 bg-lilac md:block" aria-hidden="true"></div>
    <div class="dots pointer-events-none absolute top-14 right-72 hidden h-16 w-36 text-peach/50 lg:block" aria-hidden="true"></div>

    <p class="relative mb-3 type-subtitle text-[11px] text-muted">
      {posts.length} {lang === 'id' ? 'tulisan' : posts.length === 1 ? 'post' : 'posts'}
    </p>
    <h1 class="relative mb-3 type-h1 text-heading">
      {heading}<span class="text-peach">.</span>
    </h1>
    <p class="relative max-w-md text-body">{description}</p>

    {tags.length > 0 && (
      <div id="tag-bar" class="relative mt-8 flex flex-wrap gap-2" role="group" aria-label="Filter by tag">
        <button type="button" class="tag-btn btn-pill" data-tag="" aria-pressed="true">{allLabel}</button>
        {tags.map((tag) => (
          <button type="button" class="tag-btn btn-pill" data-tag={tag.slug} aria-pressed="false">#{tag.name}</button>
        ))}
      </div>
    )}
  </section>

  <section class="container-page pb-24">
    <div id="post-list" class="grid grid-cols-1 items-stretch gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => (
        <div class="post-item" data-tags={post.tags.map((t) => t.slug).join(',')}>
          <PostCard post={post} {lang} />
        </div>
      ))}
    </div>
    {posts.length === 0 && <EmptyPosts {lang} dots={false} />}
  </section>
</Base>

<script>
  import { onPageLoad } from '../scripts/lifecycle'

  onPageLoad(() => {
    const tagBar = document.getElementById('tag-bar')
    const postList = document.getElementById('post-list')
    if (!tagBar || !postList) return

    const items = Array.from(postList.querySelectorAll<HTMLElement>('.post-item'))
    const buttons = Array.from(tagBar.querySelectorAll<HTMLButtonElement>('.tag-btn'))
    let activeTag = ''

    tagBar.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.tag-btn')
      if (!btn) return
      const tag = btn.dataset.tag ?? ''
      activeTag = tag === activeTag ? '' : tag

      for (const item of items) {
        const show = !activeTag || (item.dataset.tags ?? '').split(',').includes(activeTag)
        item.hidden = !show
      }
      for (const b of buttons) {
        b.setAttribute('aria-pressed', String((b.dataset.tag ?? '') === activeTag))
      }
    })
  })
</script>
