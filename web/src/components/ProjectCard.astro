---
import type { ResumeProjectItem } from '../lib/types'
import Icon from './Icon.astro'

interface Props {
  project: ResumeProjectItem
  index: number
}

const { project, index } = Astro.props
const hasLink = !!project.link
const [type, ...tech] = project.techStack
const num = String(index + 1).padStart(2, '0')
const MAX_TECH = 5
const Tag = hasLink ? 'a' : 'article'
const linkProps = hasLink
  ? { href: project.link!.href, target: '_blank', rel: 'noopener noreferrer' }
  : {}
---

<Tag {...linkProps} class:list={['card group flex h-full flex-col p-5', hasLink && 'card-hover']}>
  <div class="mb-5 flex items-center justify-between">
    {type && <span class="tag">{type}</span>}
    <span class="font-mono text-[11px] font-bold text-muted">{num}</span>
  </div>
  <div class="mb-2 flex items-start justify-between gap-2">
    <h3 class="type-h4 text-heading group-hover:text-link">{project.title}</h3>
    <Icon
      name="external"
      class:list={[
        'mt-1 h-4 w-4 shrink-0 transition-transform',
        hasLink ? 'text-teal group-hover:translate-x-0.5 group-hover:-translate-y-0.5' : 'text-grey-300',
      ]}
    />
  </div>
  <p class="text-sm text-body">{project.description}</p>
  {tech.length > 0 && (
    <div class="mt-auto flex flex-wrap gap-1.5 pt-5">
      {tech.slice(0, MAX_TECH).map((t) => <span class="tag tag-outline">{t}</span>)}
    </div>
  )}
</Tag>
