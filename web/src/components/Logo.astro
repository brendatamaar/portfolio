---
interface Props {
  /** Render on the navy footer band */
  inverse?: boolean
}

const { inverse = false } = Astro.props
---

<a href="/" class="group inline-flex items-center gap-2.5" aria-label="Brendatama — home">
  <!-- Hive mark: outlined hexagon-house with initials -->
  <svg class="h-8 w-8 shrink-0 text-teal" viewBox="0 0 32 32" fill="none" aria-hidden="true">
    <path
      d="M16 2.8 28 9.4v12.2a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3V9.4L16 2.8z"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linejoin="round"></path>
    <text
      x="16"
      y="20.6"
      text-anchor="middle"
      fill="currentColor"
      font-family="Poppins, sans-serif"
      font-size="10"
      font-weight="700">ba</text>
  </svg>
  <span
    class:list={[
      'text-[19px] leading-none font-semibold tracking-tight lowercase',
      inverse ? 'text-white' : 'text-heading',
    ]}
  >
    brendatama
  </span>
</a>
