---
import type { Sidenote } from '../lib/types'

interface Props {
  sidenotes: Sidenote[]
}

const { sidenotes } = Astro.props

if (!sidenotes.length) return
---

<div
  class="sidenotes relative hidden w-52 shrink-0 lg:block"
  aria-label="Sidenotes"
>
  {sidenotes.map(({ id, html }) => (
    <aside
      data-sidenote={id}
      class="absolute right-0 left-0 rounded-xs border-l-2 border-peach py-0.5 pl-3 text-xs leading-relaxed text-muted"
      set:html={`<sup class="mr-1 font-mono font-bold text-peach">[${id}]</sup>${html}`}
    />
  ))}
</div>
