---
import type { ResumeProjectItem } from '../lib/types'
import Icon from './Icon.astro'
import ProjectMedia from './ProjectMedia.astro'

interface Props {
  project: ResumeProjectItem
}

const { project } = Astro.props
const [type, ...tech] = project.techStack
const link = project.link
---

<!-- Featured card: layered composition; on hover the main image lifts and its hashtag shows -->
<article class="group grid items-center gap-10 lg:grid-cols-[1.15fr_1fr] lg:gap-14">
  <div class="relative px-6 pt-6 pb-8 sm:px-10">
    <div class="absolute top-0 left-0 h-[70%] w-[38%] rounded-xs bg-lilac/70" aria-hidden="true"></div>
    <div class="hex absolute right-0 bottom-0 aspect-[1.15] w-[30%] bg-butter" aria-hidden="true"></div>
    <div class="relative aspect-[16/10] overflow-hidden rounded-xs shadow-raised transition-transform duration-300 group-hover:-translate-y-2">
      <ProjectMedia img={project.img} title={project.title} index={1} eager />
      {tech[0] && (
        <div class="pointer-events-none absolute inset-x-0 bottom-0 flex h-20 items-end bg-linear-to-t from-navy/70 to-transparent px-5 pb-4 opacity-0 transition-opacity duration-300 group-hover:opacity-100">
          <span class="type-tag text-xs text-white">#{tech[0]}</span>
        </div>
      )}
    </div>
  </div>

  <div>
    <div class="mb-4 flex flex-wrap gap-2">
      <span class="tag">Featured</span>
      {type && <span class="tag tag-outline">{type}</span>}
    </div>
    <h3 class="type-h3 text-heading">{project.title}</h3>
    <p class="mt-3 text-body">{project.description}</p>

    <hr class="hairline mt-6 mb-4" />
    <div class="flex flex-wrap items-center justify-between gap-4">
      <ul class="flex flex-wrap gap-x-4 gap-y-1 text-[13px] text-muted">
        {tech.slice(0, 5).map((t) => (
          <li class="flex items-center gap-1.5">
            <Icon name="code" class="h-3.5 w-3.5 text-teal" />
            {t}
          </li>
        ))}
      </ul>
      {link && (
        <a href={link.href} target="_blank" rel="noopener noreferrer" class="link-arrow">
          Details
          <Icon name="arrow-right" class="h-4 w-5" />
        </a>
      )}
    </div>
  </div>
</article>
