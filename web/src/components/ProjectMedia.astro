---
// Project image, or a pastel hive placeholder when the project has none
interface Props {
  img?: string
  title: string
  index: number
  class?: string
  eager?: boolean
}

const { img, title, index, class: className = '', eager = false } = Astro.props

const PASTELS = ['bg-butter', 'bg-lilac', 'bg-apricot', 'bg-teal/40']
const pastel = PASTELS[index % PASTELS.length]
const initial = title.trim().charAt(0).toUpperCase()
---

{img ? (
  <img
    src={img}
    alt=""
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    class={`h-full w-full object-cover ${className}`}
  />
) : (
  <div class={`relative h-full w-full overflow-hidden ${pastel} ${className}`} aria-hidden="true">
    <div class="hex absolute top-1/2 left-1/2 flex aspect-[1.15] w-[42%] -translate-x-1/2 -translate-y-1/2 items-center justify-center bg-white/55 text-5xl font-bold text-navy/80">
      {initial}
    </div>
    <div class="hex absolute -top-6 -right-6 aspect-[1.15] w-[28%] bg-white/30"></div>
    <div class="hex absolute bottom-[14%] left-[14%] aspect-[1.15] w-[9%] bg-white/70"></div>
  </div>
)}
