---
import { ClientRouter } from 'astro:transitions'
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url'
import interLatinExt from '@fontsource-variable/inter/files/inter-latin-ext-wght-normal.woff2?url'
import monoLatin from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url'
import monoLatinExt from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-ext-wght-normal.woff2?url'

interface Props {
  title: string
  description: string
  ogType: string
  canonicalUrl?: string
  preconnectApi?: boolean
}

const { title, description, ogType, preconnectApi = false } = Astro.props
// Astro.url reflects the internal host behind the reverse proxy — build from `site` instead
const canonicalUrl =
  Astro.props.canonicalUrl ?? new URL(Astro.url.pathname, Astro.site).href

// Only latin + latin-ext subsets: the site has no cyrillic/greek/vietnamese text
const LATIN =
  'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD'
const LATIN_EXT =
  'U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF'

const fontFace = (family: string, weight: string, url: string, range: string) =>
  `@font-face{font-family:'${family}';font-style:normal;font-display:swap;font-weight:${weight};src:url(${url}) format('woff2-variations');unicode-range:${range}}`

const fontCss = [
  fontFace('Inter Variable', '100 900', interLatinExt, LATIN_EXT),
  fontFace('Inter Variable', '100 900', interLatin, LATIN),
  fontFace('JetBrains Mono Variable', '100 800', monoLatinExt, LATIN_EXT),
  fontFace('JetBrains Mono Variable', '100 800', monoLatin, LATIN),
].join('')
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

{/*
  Theme — runs before first paint to prevent FOUC. ClientRouter replaces <html>
  attributes on navigation, so the class is also applied to the incoming document.
*/}
<script is:inline>
  ;(function () {
    function apply(doc) {
      var s = null
      try {
        s = localStorage.getItem('theme')
      } catch (e) {}
      var d = window.matchMedia('(prefers-color-scheme: dark)').matches
      doc.documentElement.classList.toggle('dark', s === 'dark' || (s === null && d))
    }
    apply(document)
    document.addEventListener('astro:before-swap', function (e) {
      apply(e.newDocument)
    })
  })()
</script>

{/* Fonts: preload the latin subsets used above the fold */}
<link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={monoLatin} as="font" type="font/woff2" crossorigin />
<style is:inline set:html={fontCss}></style>

{/* Favicons */}
<link rel="icon" type="image/svg+xml" href="/images/favicon/favicon.svg" />
<link rel="icon" type="image/png" sizes="96x96" href="/images/favicon/favicon-96x96.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/images/favicon/apple-touch-icon.png" />
<link rel="manifest" href="/images/favicon/site.webmanifest" />

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />

{/* Open Graph */}
<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:site_name" content="Brendatama Akbar" />
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />

{preconnectApi && <link rel="preconnect" href="https://api.brendatama.dev" />}

<ClientRouter />
