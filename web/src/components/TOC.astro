---
import type { TocItem } from '../lib/types'

interface Props {
  toc: TocItem[]
  hasGlossary?: boolean
  hasBibliography?: boolean
}

const { toc, hasGlossary = false, hasBibliography = false } = Astro.props

if (!toc.length && !hasGlossary && !hasBibliography) return

const minLevel = toc.length ? Math.min(...toc.map((t) => t.level)) : 2

const counters = new Array(7).fill(0)
const numbered = toc.map((item) => {
  counters[item.level]++
  for (let l = item.level + 1; l <= 6; l++) counters[l] = 0
  const num = counters.slice(minLevel, item.level + 1).join('.')
  return { ...item, num }
})

// Active link (set by scrollspy) gets the teal tab indicator
const linkClass =
  '-ml-px block border-l-2 border-transparent py-1 pl-3 text-[13px] leading-snug text-muted transition-colors hover:text-heading data-[active]:border-teal data-[active]:font-semibold data-[active]:text-link'
---

<nav class="toc sticky top-24 hidden w-52 shrink-0 lg:block" aria-label="Table of contents">
  {toc.length > 0 && (
    <>
      <p class="mb-3 type-subtitle text-[11px] text-muted">Contents</p>
      <ul class="border-l border-line-soft">
        {numbered.map((item) => (
          <li style={`padding-left: ${(item.level - minLevel) * 10}px`}>
            <a href={`#${item.id}`} data-toc-link={item.id} class={linkClass}>
              <span class="mr-1.5 text-[11px] font-semibold text-peach tabular-nums">{item.num}</span>
              {item.text}
            </a>
          </li>
        ))}
      </ul>
    </>
  )}

  {(hasGlossary || hasBibliography) && (
    <ul class:list={['border-l border-line-soft', toc.length && 'mt-5']}>
      {hasGlossary && (
        <li>
          <a href="#glossary-section" data-toc-link="glossary-section" class={linkClass}>Glossary</a>
        </li>
      )}
      {hasBibliography && (
        <li>
          <a href="#bibliography-section" data-toc-link="bibliography-section" class={linkClass}>Bibliography</a>
        </li>
      )}
    </ul>
  )}
</nav>
