---
import type { GlossaryEntry } from '../lib/types'
import Icon from './Icon.astro'

interface Props {
  glossary: GlossaryEntry[]
}

const { glossary } = Astro.props

if (!glossary.length) return

const sorted = [...glossary].sort((a, b) => a.num - b.num)
---

<section id="glossary-section" class="panel overflow-hidden" aria-label="Glossary">
  <button
    id="glossary-toggle"
    type="button"
    class="flex w-full items-center justify-between px-6 py-5 text-left transition-colors hover:bg-sunken sm:px-9"
    aria-expanded="false"
    aria-controls="glossary-body"
  >
    <span class="flex items-center gap-3">
      <span class="type-subtitle text-heading">Glossary</span>
      <span class="tag">{glossary.length}</span>
    </span>
    <span id="glossary-chevron" class="text-teal transition-transform">
      <Icon name="chevron-down" class="h-5 w-5" />
    </span>
  </button>

  <div id="glossary-body" class="overflow-hidden" style="max-height: 0">
    <dl class="m-0 border-t border-line-soft px-6 sm:px-9">
      {sorted.map((entry) => (
        <div
          class="glossary-entry -mx-3 cursor-pointer border-b border-line-soft px-3 py-4 transition-colors last:border-0 hover:bg-sunken"
          data-gloss-key={entry.key}
        >
          <dt class="mb-1 flex items-baseline gap-2.5 font-semibold text-heading">
            <span class="tag tag-outline">{entry.num}</span>
            {entry.term}
          </dt>
          <dd class="m-0 text-sm text-body" set:html={entry.definition} />
        </div>
      ))}
    </dl>
  </div>
</section>

<script>
  import { onPageLoad } from '../scripts/lifecycle'

  onPageLoad(() => {
    const toggle = document.getElementById('glossary-toggle')
    const body = document.getElementById('glossary-body')
    const chevron = document.getElementById('glossary-chevron')
    if (!toggle || !body || !chevron) return

    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true'
      toggle.setAttribute('aria-expanded', String(!open))
      chevron.style.transform = open ? '' : 'rotate(180deg)'
      body.style.maxHeight = open ? '0' : `${body.scrollHeight}px`
    })

    document.querySelectorAll<HTMLElement>('.glossary-entry').forEach((el) => {
      el.addEventListener('click', () => {
        const key = el.dataset.glossKey
        if (!key) return
        const ref = document.querySelector<HTMLElement>(`[data-gloss-key="${key}"]`)
        if (!ref || ref === el) return
        ref.scrollIntoView({ behavior: 'smooth', block: 'center' })
      })
    })
  })
</script>
