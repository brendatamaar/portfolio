---
interface Props {
  num: string
  label: string
  /** Small uppercase line above the heading */
  eyebrow?: string
}
const { num, label, eyebrow } = Astro.props
---

<div class="mb-10 flex flex-wrap items-end justify-between gap-4">
  <div>
    {eyebrow && <p class="mb-2 type-subtitle text-muted">{eyebrow}</p>}
    <h2 class="type-h2 text-heading">
      <span class="text-peach">{num}.</span> {label}
    </h2>
  </div>
  <slot />
</div>
