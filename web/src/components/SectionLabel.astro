---
interface Props {
  num: string
  label: string
}
const { num, label } = Astro.props
---

<div class="mb-8 flex items-center gap-4 border-b border-line pb-4">
  <span class="font-mono text-[11px] font-bold text-peach">{num}</span>
  <h2 class="type-subtitle font-semibold text-heading">{label}</h2>
</div>
