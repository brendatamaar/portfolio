# Production .env for docker-compose.yml (lives next to it on the VPS, never committed)

# Cloudflare Zero Trust → Networks → Tunnels → your tunnel → install token
CLOUDFLARE_TUNNEL_TOKEN=

# Browser origins allowed to call the API with credentials
CORS_ORIGINS=https://www.brendatama.dev,https://admin.brendatama.dev

# Admin session cookie is shared across subdomains
COOKIE_DOMAIN=.brendatama.dev

# Public URL of the admin app (SvelteKit CSRF check)
ADMIN_ORIGIN=https://admin.brendatama.dev

# Optional: pin a specific build (git SHA). Defaults to latest.
# IMAGE_TAG=
